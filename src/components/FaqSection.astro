---
import { IconButton } from "@udixio/ui-react";
import { iKeyboardArrowDown } from "@udixio/icons-outlined-400/keyboard_arrow_down";

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  questions: FaqItem[];
}

const { questions } = Astro.props;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<section
  id="faq"
  class="tab-menu theme-blue z-10"
  aria-labelledby="faq-title"
>
  <div class="section">
    <div class="grid gap-12 lg:grid-cols-[minmax(16rem,0.8fr)_minmax(0,1.35fr)] lg:gap-20 xl:gap-28">
      <header class="max-w-xl lg:sticky lg:top-28 lg:self-start">
        <p class="flex items-center gap-3 text-title-medium text-secondary">
          <span class="h-px w-8 bg-secondary/60" aria-hidden="true"></span>
          En pratique
        </p>
        <h2 id="faq-title" class="mt-3 text-headline-large text-on-surface md:text-display-small">
          Questions fréquentes
        </h2>
        <p class="mt-5 max-w-lg text-body-large text-on-surface-variant">
          Des réponses directes sur mon travail, ma façon de collaborer et le déroulement d’un projet.
        </p>
      </header>

      <div class="space-y-1">
        {questions.map((item, index) => {
          const questionId = `faq-question-${index + 1}`;
          const answerId = `faq-answer-${index + 1}`;

          return (
          <article
            data-faq-item
            data-open="false"
            class="group -mx-4 rounded-2xl px-4 transition-colors duration-200 hover:bg-surface-container-low data-[open=true]:bg-surface-container-low motion-reduce:transition-none"
          >
            <div
              data-faq-header
              class="flex cursor-pointer items-center gap-5 py-6 md:py-7"
            >
              <h3
                id={questionId}
                class="flex-1 text-title-large text-on-surface transition-colors duration-200 group-hover:text-primary group-data-[open=true]:text-primary motion-reduce:transition-none"
              >
                {item.question}
              </h3>
              <IconButton
                icon={iKeyboardArrowDown}
                label={item.question}
                variant="standard"
                shape="rounded"
                data-faq-trigger
                aria-expanded="false"
                aria-controls={answerId}
                className="shrink-0 text-primary transition-transform duration-300 group-data-[open=true]:rotate-180 motion-reduce:transition-none"
              />
            </div>

            <div
              id={answerId}
              role="region"
              aria-labelledby={questionId}
              class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out group-data-[open=true]:grid-rows-[1fr] group-data-[open=true]:opacity-100 motion-reduce:transition-none"
            >
              <div class="overflow-hidden">
                <div class="mb-7 max-w-3xl pr-10 md:mb-8 md:pr-20">
                  <p class="text-body-large leading-relaxed text-on-surface-variant">
                    {item.answer}
                  </p>
                </div>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
</section>

<script>
  const initializeFaq = () => {
    document.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((item) => {
      if (item.dataset.faqReady === "true") return;

      const header = item.querySelector<HTMLElement>("[data-faq-header]");
      const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
      if (!header || !trigger) return;

      item.dataset.faqReady = "true";
      header.addEventListener("click", () => {
        const willOpen = item.dataset.open !== "true";

        item.dataset.open = String(willOpen);
        trigger.setAttribute("aria-expanded", String(willOpen));
      });
    });
  };

  initializeFaq();
  document.addEventListener("astro:page-load", initializeFaq);
</script>
