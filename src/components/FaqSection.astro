---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  questions: FaqItem[];
}

const { questions } = Astro.props;

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<section
  id="faq"
  class="tab-menu theme-blue overflow-hidden bg-surface py-20 md:py-28"
  aria-labelledby="faq-title"
>
  <div class="max-width padding-x">
    <div class="grid gap-12 lg:grid-cols-[minmax(16rem,0.8fr)_minmax(0,1.35fr)] lg:gap-20 xl:gap-28">
      <header class="max-w-xl lg:sticky lg:top-28 lg:self-start">
        <p class="text-title-medium text-tertiary">Questions fréquentes</p>
        <h2 id="faq-title" class="mt-3 text-headline-large text-on-surface md:text-display-small">
          Questions avant un premier échange
        </h2>
        <p class="mt-5 max-w-lg text-body-large text-on-surface-variant">
          Périmètre, collaboration, méthode&nbsp;: voici les réponses aux questions qui reviennent le plus souvent.
        </p>
      </header>

      <div class="space-y-3">
        {questions.map((item, index) => {
          const questionId = `faq-question-${index + 1}`;
          const answerId = `faq-answer-${index + 1}`;

          return (
          <article
            data-faq-item
            data-open="false"
            class="group rounded-3xl border border-outline-variant bg-surface-container-low shadow-[0_1px_0_rgb(0_0_0/0.03)] transition-[border-color,background-color,box-shadow] duration-200 hover:border-primary/50 hover:bg-surface-container data-[open=true]:border-primary/50 data-[open=true]:bg-surface-container data-[open=true]:shadow-[0_16px_40px_rgb(0_0_0/0.08)] motion-reduce:transition-none"
          >
            <h3>
              <button
                id={questionId}
                type="button"
                data-faq-trigger
                aria-expanded="false"
                aria-controls={answerId}
                class="flex w-full cursor-pointer items-center gap-4 rounded-3xl px-5 py-5 text-left focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:gap-6 md:px-7 md:py-6"
              >
                <span class="w-7 shrink-0 text-label-large text-tertiary" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="flex-1 text-title-large text-on-surface">{item.question}</span>
                <span class="relative grid size-10 shrink-0 rotate-0 place-items-center rounded-full bg-surface-container-high text-primary transition-[color,background-color,transform] duration-300 group-hover:bg-primary-container group-hover:text-on-primary-container group-data-[open=true]:rotate-180 group-data-[open=true]:bg-primary-container group-data-[open=true]:text-on-primary-container motion-reduce:transition-none" aria-hidden="true">
                  <span class="absolute h-0.5 w-4 rounded-full bg-current"></span>
                  <span class="absolute h-4 w-0.5 scale-y-100 rounded-full bg-current transition-transform duration-300 group-data-[open=true]:scale-y-0 motion-reduce:transition-none"></span>
                </span>
              </button>
            </h3>

            <div
              id={answerId}
              role="region"
              aria-labelledby={questionId}
              class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-in-out group-data-[open=true]:grid-rows-[1fr] group-data-[open=true]:opacity-100 motion-reduce:transition-none"
            >
              <div class="overflow-hidden">
                <p class="max-w-3xl pb-6 pl-16 pr-5 text-body-large text-on-surface-variant md:pb-7 md:pl-[5.25rem] md:pr-20">
                  {item.answer}
                </p>
              </div>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
</section>

<script>
  const initializeFaq = () => {
    document.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((item) => {
      if (item.dataset.faqReady === "true") return;

      const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
      if (!trigger) return;

      item.dataset.faqReady = "true";
      trigger.addEventListener("click", () => {
        const willOpen = item.dataset.open !== "true";

        item.dataset.open = String(willOpen);
        trigger.setAttribute("aria-expanded", String(willOpen));
      });
    });
  };

  initializeFaq();
  document.addEventListener("astro:page-load", initializeFaq);
</script>
