---
import {Card} from "@components/Card";
import {Techno} from "@components/Techno";
import {Line} from '@components/Line';
import {LinearGradient} from "@components/LinearGradient";
import {BackgroundColor} from "@components/BackgroundColor";
import {Button} from "@udixio/ui-react";

import {iApi} from "@udixio/icons-outlined-400/api";
import {iManufacturing} from "@udixio/icons-outlined-400/manufacturing";
import {iMail} from "@udixio/icons-outlined-400/mail";
import {faNodeJs, faGolang} from "@fortawesome/free-brands-svg-icons";

import nestLogo from "@assets/images/nest-logo.svg?raw";
import expressLogo from "@assets/images/express-logo.svg?raw";
import tsLogo from "@assets/images/ts-logo.svg?raw";
---
<div id="back-end" class="tab-menu theme-green">
    <section class="md:pt-64 pt-48">
        <div class="section">
            <h2 class="text-center text-title-medium text-tertiary">Back-end</h2>
            <h3 class="text-center text-headline-large md:text-display-medium mt-2 mb-8 max-w-prose mx-auto">
                Derrière chaque application de qualité se cache un <span
                    class="text-gradient">développement back-end</span>
                solide</h3>
            <p class="text-center text-body-large max-w-prose mx-auto">En tant que développeur full stack,
                j’assure la
                performance, la sécurité et la fiabilité de vos projets grâce à des solutions back-end
                robustes.</p>
        </div>
    </section>
    <section>
        <div class="max-width">
            <div class="padding-x grid grid-cols-1 -mx-2 md:grid-cols-3 lg:grid-cols-3 gap-x-6 gap-y-4">
                <Card client:visible data-aos="zoom-in" variant="filled"
                      className="group ">
                    <Techno variant="primary" className="p-6 pb-10"
                            icon={iApi}
                            name="Choix d'APIs Adaptées"
                    >
                        <p>Selon les besoins du projet, des solutions telles que GraphQL, REST ou gRPC sont
                            envisagées. Ces choix permettent une intégration fluide et optimisent la
                            communication entre les services.</p>
                        <p class="mt-4">Chaque API est sélectionnée pour offrir la meilleure expérience
                            utilisateur et garantir une performance optimale.
                        </p>
                    </Techno>
                </Card>
                <Card client:visible data-aos="zoom-in" data-aos-delay={150} variant="filled"
                      className="group">
                    <Techno variant="primary" className="p-6 pb-10" icon={iApi}
                            name="Architecture Flexible et Efficace"
                    ><p>Optez pour des architectures monolithiques simples ou des microservices flexibles, avec
                        une modularité accrue grâce à l’inversion de contrôle (IoC).
                    </p>
                        <p class="mt-4">
                            Cette approche assure que la structure du projet est à la fois robuste et adaptée
                            aux évolutions futures.
                        </p>
                    </Techno>

                </Card>
                <Card client:visible data-aos="zoom-in" data-aos-delay={300} variant="filled"
                      className="group">
                    <Techno variant="primary" className="p-6 pb-10" icon={iApi}
                            name="Solutions Serverless"
                    ><p>Les solutions serverless sont privilégiées pour une gestion simplifiée et une
                        scalabilité automatique. Cette méthode réduit la complexité de l'infrastructure.
                    </p>
                        <p class="mt-4">
                            Elle permet ainsi de se concentrer pleinement sur le développement des
                            fonctionnalités tout en offrant flexibilité et efficacité.</p>
                    </Techno>
                </Card>
            </div>
            <div class="flex h-64">
                <div>
                    <Line client:idle isFirst/>
                </div>
            </div>
        </div>
    </section>
    <section class="pt-8">
        <BackgroundColor speed={5_000} size="max(60vw, 800px)" count={5} client:idle
                         className="absolute opacity-20 size-full top-0 left-0"></BackgroundColor>
        <div class="max-width">
            <div class="flex">
                <div>
                    <Line isLast client:idle icon={iManufacturing }/>
                </div>
                <div class="padding pt-0">
                    <h2 data-aos="fade-right" class="text-title-large">Languages & Frameworks</h2>
                    <div data-aos="fade-right" data-aos-delay="100"
                         class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                        <h3 class="text-gradient">Chaque project a ses solutions</h3>
                        <p>Je vous accompagne à l'aide ma maîtrise de divers langages à choisir les bonnes
                            technologies</p>
                    </div>
                </div>
            </div>
            <div class="grid padding-x lg:grid-cols-5 md:grid-cols-2 grid-cols-1 gap-6">
                <Card client:visible data-aos="zoom-in" variant="filled"
                      className="lg:col-span-3 md:col-span-2 p-6">
                    <Techno buttonLabel="En voir plus" variant="primary" className=""
                            image={nestLogo}
                            name="Nest.Js"
                    >
                        <p>Offre une structure modulaire et un support TypeScript pour créer des applications
                            back-end
                            robustes et évolutives.</p>
                    </Techno>
                    <p class="mt-8 text-label-large">Maîtriser NestJS implique également l'utilisation de :</p>
                    <div class="mt-4 flex flex-col gap-4">
                        <Techno image={expressLogo} name="Express.Js">
                            <p>Simplifie la création d'applications web avec une API légère et flexible pour le
                                routage
                                et la gestion des requêtes.</p>
                        </Techno>
                        <Techno icon={faNodeJs} name="Node.Js">
                            <p>Permet d'exécuter JavaScript côté serveur pour créer des applications rapides et
                                évolutives avec un accès aux ressources système.</p>
                        </Techno>
                        <Techno image={tsLogo} name="Typescript">
                            <p>Renforce JavaScript avec des types statiques pour un code plus sûr, clair et
                                facile à
                                maintenir.</p>
                        </Techno>
                    </div>
                </Card>
                <Card client:visible data-aos="zoom-in" data-aos-delay={150}
                      className="lg:col-span-2 row-span-1"
                      variant="filled">
                    <Techno variant="primary" className="p-6" icon={faGolang}
                            name="Go"
                    ><p>Garantit une performance élevée et une gestion efficace de la concurrence, idéal pour
                        des
                        applications rapides et pour des systèmes variés grâce à sa compilation en binaire.</p>
                    </Techno>
                </Card>
            </div>
            <div class="flex h-64">
                <div>
                    <Line client:idle isFirst/>
                </div>
            </div>
        </div>
    </section>
    <section class="pt-8">
        <div class="max-width">
            <div class="flex">
                <div>
                    <Line isLast client:idle icon={iManufacturing }/>
                </div>
                <div class="padding pt-0">
                    <h2 data-aos="fade-right" class="text-title-large"><strong>C</strong>ontent
                        <strong>M</strong>anagement
                        <strong>S</strong>ystem</h2>
                    <div data-aos="fade-right" data-aos-delay="100"
                         class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                        <h3 class="text-gradient">Restez maître de votre contenu</h3>
                        <p>Je sélectionne le CMS adapté pour répondre précisément à vos besoins.</p>
                    </div>
                    <div class="flex md:flex-row flex-col gap-8 mt-16">
                        <Card client:visible data-aos="zoom-in" variant="filled"
                              className="group ">
                            <Techno variant="primary" className="p-6 pb-10"
                                    icon={iApi}
                                    name="Sanity"
                            >
                                <p>CMS headless offrant une gestion efficace des contenus structurés. Idéal
                                    pour
                                    des
                                    projets nécessitant une séparation entre contenu et présentation.</p>
                            </Techno>
                        </Card>
                        <Card client:visible data-aos="zoom-in" data-aos-delay={150} variant="filled"
                              className="group">
                            <Techno variant="primary" className="p-6 pb-10" icon={iApi}
                                    name="Builder.io"
                            ><p>CMS drag-and-drop facilitant la création de pages dynamiques sans codage. Idéal
                                pour
                                des
                                mises à jour rapides et une intégration fluide avec des frameworks modernes.
                            </p>
                            </Techno>
                        </Card>
                        <Card client:visible data-aos="zoom-in" data-aos-delay={300} variant="filled"
                              className="group">
                            <Techno variant="primary" className="p-6 pb-10" icon={iApi}
                                    name="Wordpress"
                            ><p>Le CMS le plus populaire pour sa flexibilité, ses thèmes et plugins variés.
                                Idéal
                                pour
                                blogs et sites d'entreprise avec une gestion facile du contenu..
                            </p>
                            </Techno>
                        </Card>
                    </div>
                    <div data-aos="fade-right" data-aos-delay="100">
                        <p class="text-body-large max-w-prose mt-8">Votre CMS préféré n’est pas dans cette
                            liste ? Pas
                            d'inquiétude !<br/> Cette liste n'est pas exhaustive ! Et même si celui-ci m'est
                            inconnu, je suis prêt à le prendre en main et à l'intégrer parfaitement à votre
                            projet.</p>
                        <Button className="w-fit mt-4" href="/contact" icon={iMail} label="Contactez-moi"/>
                    </div>
                </div>
            </div>
        </div>
        <LinearGradient nextTheme="blue"/>
    </section>
</div>