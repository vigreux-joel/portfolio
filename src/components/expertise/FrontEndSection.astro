---
import {Card} from "@components/Card";
import {Techno} from "@components/Techno";
import {Line} from '@components/Line';
import {LinearGradient} from "@components/LinearGradient";

import {Icon, Button} from "@udixio/ui-react";

import astroLogo from "@assets/images/astro-logo.svg?raw";
import reactLogo from "@assets/images/react-logo.svg?raw";
import angularLogo from "@assets/images/angular-logo.svg?raw";
import tsLogo from "@assets/images/ts-logo.svg?raw";
import tailwindLogo from "@assets/images/tailwind-logo.svg?raw";
import motionLogo from "@assets/images/framer-motion-logo.svg?raw";
import sassLogo from "@assets/images/sass-logo.svg?raw";

import {iDevices} from "@udixio/icons-outlined-400/devices";
import {iSelectWindow} from "@udixio/icons-outlined-400/select_window";
import {iArrowOutward} from "@udixio/icons-outlined-400/arrow_outward";
import {faAndroid, faApple, faLinux, faWindows} from "@fortawesome/free-brands-svg-icons";
import { iCode } from "@udixio/icons-outlined-400/code";
import {BackgroundColor} from "@components/BackgroundColor.tsx";
---
<div id="front-end" class="theme-purple surface">

  <section >
    <div class="max-width">
    <!-- Introduction de Section : sur le spine (ligne continue, alignée au Hero) -->
    <div class="flex  pt-8">
      <div>
        <Line client:idle icon={iCode} nextTheme="purple" />
      </div>
      <div class="padding pt-0 flex flex-col justify-center max-w-4xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Front-end">Ingénierie Front-End</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
          <h3 class="text-gradient">Un produit bien construit fait la différence</h3>
          <p>Je pose les fondations techniques pour qu'il dure et s'adapte à vos besoins</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-prose">
          Je ne pars jamais d'un framework par défaut. Je choisis l'architecture front-end selon votre produit, ses contraintes de performance et l'échelle visée.
        </p>
      </div>
    </div>

    <!-- Le tracé se dédouble : Astro descend tout droit, Angular bifurque -->
    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle  />
      <Line fromX={0} fromPx={60} toX={0.5} toPx={76} client:idle />
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-12 mt-8">
      <!-- Astro : le contenu -->
      <div class="flex">
        <div>
          <Line client:idle image={astroLogo}  />
        </div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-label-large uppercase tracking-[0.2em] text-tertiary">Le contenu</span>
          <h3 class="text-gradient text-headline-small md:text-headline-medium mt-2 w-fit">Astro & React</h3>
          <p class="max-w-prose mt-4 text-body-large text-on-surface-variant">
            Pour les sites où la performance prime : Astro génère un HTML statique ultra-rapide pour un SEO optimal, tandis que React s'intègre par îlots pour apporter une interactivité riche et dynamique exactement là où c'est nécessaire.
          </p>
          <span class="block mt-5 text-label-medium text-tertiary uppercase">
            Portfolios • Sites éditoriaux • Sites vitrines
          </span>
        </div>
      </div>

      <!-- Angular : l'application -->
      <div class="flex">
        <div>
          <Line client:idle image={angularLogo}  />
        </div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-label-large uppercase tracking-[0.2em] text-tertiary">L'application</span>
          <h3 class="text-gradient text-headline-small md:text-headline-medium mt-2 w-fit">Angular & Svelte</h3>
          <p class="max-w-prose mt-4 text-body-large text-on-surface-variant">
            Pour les applications web avancées : Angular offre une architecture stricte et robuste pour maintenir de grandes bases de code dans le temps, tandis que Svelte apporte une réactivité native inégalée et une légèreté maximale pour des interfaces fluides.
          </p>
          <span class="block mt-5 text-label-medium text-tertiary uppercase">
            ERP • Portails métier • Applications internes
          </span>
        </div>
      </div>
    </div>

    <!-- Convergence vers le même but -->
    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle />
      <Line fromX={0.5} fromPx={76} toX={0} toPx={60} client:idle  />
    </div>

    <!-- Ligne au-dessus du bandeau (isLast) -->
    <div class="relative h-16 md:h-24 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} isLast client:idle />
    </div>

    <!-- Bandeau technique -->
    <div class="max-width">
      <div class="flex">
        <!-- Espace pour s'aligner parfaitement avec les blocs Astro/Angular -->
        <div>
          <Line visible={false} client:idle />
        </div>
        <div class="padding py-8 md:py-12 w-full">
          <span class="text-label-large uppercase tracking-[0.2em] text-tertiary block text-left">Des fondations robustes</span>
          <div class="mt-6 flex flex-wrap justify-start gap-x-10 gap-y-6 text-on-surface-variant">
            <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
              <div class="h-9 w-9 flex items-center justify-center [&>svg]:max-w-full [&>svg]:max-h-full fill-current" set:html={tsLogo} />
              <span class="text-label-medium">TypeScript</span>
            </div>
            <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
              <div class="h-9 w-9 flex items-center justify-center [&>svg]:max-w-full [&>svg]:max-h-full fill-current" set:html={tailwindLogo} />
              <span class="text-label-medium">Tailwind CSS</span>
            </div>
            <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
              <div class="h-9 w-9 flex items-center justify-center [&>svg]:max-w-full [&>svg]:max-h-full fill-current" set:html={motionLogo} />
              <span class="text-label-medium">Motion</span>
            </div>
            <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
              <div class="h-9 w-9 flex items-center justify-center [&>svg]:max-w-full [&>svg]:max-h-full fill-current" set:html={sassLogo} />
              <span class="text-label-medium">CSS / Sass</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Séquence 2 : L'Apothéose Immersive (React + Motion) -->
  <section >

    <!-- Ligne de connexion au-dessus de la carte -->
    <div class="max-width">
      <div class="relative h-24 hidden md:block">
        <Line fromX={0} fromPx={60} toX={0.5} toPx={0} isFirst client:idle />
      </div>
      <div class="relative h-12 md:hidden">
        <Line fromX={0} fromPx={28} toX={0.5} toPx={0} isFirst client:idle />
      </div>
    </div>

    <div class="max-width padding-x relative">
      <BackgroundColor
          speed={7_500}
          size="max(100%, 800px)"
          count={3}
          client:idle
          className="absolute opacity-40 size-full top-0 left-0 "
      />
      <div class="relative w-full z-0">

        <Card energyX="50%" client:load variant="elevated" className="group/react overflow-hidden relative z-10 p-0 w-full shadow-2xl">

          <div class="grid grid-cols-1 lg:grid-cols-12 lg:min-h-[540px] relative z-10">

            <!-- Colonne Gauche : Identité + discours animation & Material Design 3 -->
            <div class="lg:col-span-6 relative z-20  padding flex flex-col justify-center ">

              <h2 class="text-title-large text-tertiary">Experience utilisateur</h2>

              <h3 class="relative reveal-light group mt-10 text-headline-medium md:text-display-small font-light leading-tight">
                <span class="text-on-surface transition-opacity duration-1000 group-[.light]:opacity-0">Démarquez votre produit au premier regard</span>
                <span class="absolute inset-0 text-transparent bg-clip-text bg-gradient-to-r from-primary to-tertiary opacity-0 transition-opacity duration-1000 group-[.light]:opacity-100" aria-hidden="true">Démarquez votre produit au premier regard</span>
              </h3>

              <p class="mt-4 text-headline-small md:text-headline-medium text-on-surface">
                J'anime vos interfaces avec des animations qui captent l'attention
              </p>

              <div class="mt-8 flex flex-col gap-6 text-body-large text-on-surface-variant leading-relaxed max-w-prose">
                <p>
                  <strong class="text-on-surface font-medium">Architecture UI :</strong> 
                  Habitué aux standards comme <a href="/projets/udixio-ui" class="text-on-surface underline hover:text-primary transition-colors">Material 3</a>, j'intègre vos maquettes avec une exigence millimétrée. Je traduis votre charte graphique en un système technique solide, pour garantir un rendu visuel harmonieux, sans la moindre friction pour vous.
                </p>
                <p>
                  <strong class="text-on-surface font-medium">Motion Design & Fluidité :</strong> 
                  Je maîtrise pleinement Motion, ce qui me permet de créer rapidement des designs fluides, des transitions organiques et des comportements animés 100% customisés.
                </p>
              </div>
            </div>

            <!-- Colonne Droite : la vidéo, visuel pleine hauteur (bleed), menant à l'étude de cas -->
            <a
              href="/projets/udixio-ui"
              aria-label="Voir l'étude de cas de ma librairie UI Material 3"
              class="group relative block lg:col-span-6 min-h-[260px] sm:min-h-[340px] lg:min-h-0 overflow-hidden"
            >
              <video
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                autoplay
                loop
                muted
                playsinline
              >
                <source src="/video/output.mp4" type="video/mp4" />
              </video>
              <!-- liseré dégradé pour fondre la vidéo dans la carte côté texte -->
              <div class="absolute inset-0 hidden lg:block pointer-events-none bg-gradient-to-r from-surface/70 via-transparent to-transparent"></div>
            </a>

          </div>

          <!-- Panneau preuve flottant : chevauche la frontière texte / vidéo -->

            <Card variant="elevated" client:load className="p-6 z-30 m-6 lg:m-0 lg:absolute lg:bottom-8 lg:right-8 lg:max-w-sm opacity-0 translate-y-4 group-hover/react:opacity-100 group-hover/react:translate-y-0 transition-all duration-500 pointer-events-none group-hover/react:pointer-events-auto">
              <p class="text-body-medium text-on-surface-variant">
                Découvrez <span class="text-on-surface font-medium">Udixio UI</span>, mon étude de cas sur l'architecture et l'intégration de composants selon les standards Material 3.
              </p>
              <Button client:visible className="w-fit mt-4" variant="text" href="/projets/udixio-ui" icon={iArrowOutward} label="Voir l'étude de cas" />
            </Card>


        </Card>
      </div>

      <!-- Ligne de sortie Mobile uniquement -->
      <div class="flex justify-center h-24 lg:hidden">
         <Line client:idle />
      </div>
    </div>

    <!-- Ligne de connexion en-dessous de la carte -->
    <div class="max-width">
      <div class="relative h-24 hidden md:block">
        <Line fromX={0.5} toX={0.5} client:idle />
      </div>
    </div>

    <!-- Connecteur return : centre revient à gauche -->
    <div class="max-width">
      <div class="relative h-24 md:h-32">
        <Line fromX={0.5} fromPx={0} toX={0} toPx={60} client:idle />
      </div>
    </div>
  </section>



  <section id="multiplateforme">
    <div class="max-width">
      <div class="flex">
        <div>
          <Line client:idle  icon={iDevices}/>
        </div>
        <div class="padding pt-8">
          <div class="flex items-center md:flex-row flex-col">
            <div class="left">
              <h2 class="text-title-large text-tertiary">Développement
                multiplateforme</h2>
              <div
                   class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                <h3 class="text-gradient">Touchez un public plus large</h3>
                <p>Je convertis vos idées en applications adaptables à tous les
                  appareils</p>
              </div>
              <p class="max-w-prose mt-8 text-body-large">
                Flutter me permet de créer des applications pour
                mobiles, web, bureau et intégrés à partir d'une seule base de code. J'apprécie
                particulièrement
                son efficacité dans le développement multiplateforme, ce qui facilite grandement mon
                travail.</p>

            </div>
          </div>
          <!-- Bandeau d'icônes plateformes : une base de code, tous les écrans -->
          <div class="mt-12">
            <span class="text-label-large uppercase tracking-wide text-tertiary">Une base de code → tous les écrans</span>
            <div class="mt-6 flex flex-wrap items-start gap-x-10 gap-y-6 text-on-surface-variant">
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={iSelectWindow}/>
                <span class="text-label-medium">Web</span>
              </div>
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={faApple}/>
                <span class="text-label-medium">iOS</span>
              </div>
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={faAndroid}/>
                <span class="text-label-medium">Android</span>
              </div>
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={faWindows}/>
                <span class="text-label-medium">Windows</span>
              </div>
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={faApple}/>
                <span class="text-label-medium">macOS</span>
              </div>
              <div class="flex flex-col items-center gap-2 transition-colors hover:text-primary">
                <Icon className="h-9 w-9" icon={faLinux}/>
                <span class="text-label-medium">Linux</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <LinearGradient nextTheme="green"/>
  </section>
</div>