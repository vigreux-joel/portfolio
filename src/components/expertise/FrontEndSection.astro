---
import {Card} from "@components/Card";
import {Techno} from "@components/Techno";
import {Line} from '@components/Line';
import {LinearGradient} from "@components/LinearGradient";
import {Icon, Divider} from "@udixio/ui-react";

import astroLogo from "@assets/images/astro-logo.svg?raw";
import reactLogo from "@assets/images/react-logo.svg?raw";
import angularLogo from "@assets/images/angular-logo.svg?raw";

import {iDevices} from "@udixio/icons-outlined-400/devices";
import {iSelectWindow} from "@udixio/icons-outlined-400/select_window";
import {faAndroid, faApple, faLinux, faWindows} from "@fortawesome/free-brands-svg-icons";
---
<div id="front-end" class=" tab-menu theme-purple">
  <section>
    <div class="max-width ">

      <div class="padding-x grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Bloc narration expertise fondations -->
        <Card client:visible data-aos="fade-up" className="lg:col-span-12 p-8 md:p-12 flex flex-col lg:flex-row gap-8 items-center">
          <div class="flex-1">
            <h3 class="text-headline-medium text-on-surface mb-6 text-gradient">L'Ingénierie au service de l'Expérience</h3>
            <p class="text-body-large text-on-surface-variant max-w-prose">
              Une interface d'exception repose sur des fondations techniques solides. J'intègre systématiquement un <strong>typage strict avec TypeScript</strong> pour sécuriser le code, une structuration modulaire via <strong>Tailwind CSS & Material 3</strong>, ainsi que des animations fluides grâce à <strong>Framer Motion</strong>. Chaque décision, y compris le respect des normes d'<strong>accessibilité (a11y)</strong>, vise à maximiser la conversion et la pérennité du produit.
            </p>
          </div>
          <div class="flex flex-wrap gap-4 lg:w-1/3 justify-center">
             <div class="px-4 py-2 rounded-full border border-surface-variant text-label-large text-on-surface-variant">TypeScript</div>
             <div class="px-4 py-2 rounded-full border border-surface-variant text-label-large text-on-surface-variant">Tailwind CSS</div>
             <div class="px-4 py-2 rounded-full border border-surface-variant text-label-large text-on-surface-variant">Accessibilité (a11y)</div>
             <div class="px-4 py-2 rounded-full border border-surface-variant text-label-large text-on-surface-variant">Framer Motion</div>
             <div class="px-4 py-2 rounded-full border border-surface-variant text-label-large text-on-surface-variant">Material 3</div>
          </div>
        </Card>

        <!-- Astro -->
        <Card client:visible data-aos="fade-up" data-aos-delay="100" className="lg:col-span-4 p-8 flex flex-col group">
          <Techno variant="primary" className="h-full flex flex-col" image={astroLogo} name="Performance & SEO (Astro)">
            <p>
              Génération de sites ultra-performants. Un temps de chargement réduit garantit un engagement optimal et un meilleur référencement naturel.
            </p>
          </Techno>
        </Card>

        <!-- React -->
        <Card client:visible data-aos="fade-up" data-aos-delay="200" className="lg:col-span-4 p-8 flex flex-col group">
          <Techno variant="primary" className="h-full flex flex-col" image={reactLogo} name="Interactivité (React)">
            <p>
              Création d'interfaces riches et dynamiques avec des composants réutilisables, offrant une fluidité proche du natif pour vos utilisateurs.
            </p>
          </Techno>
        </Card>

        <!-- Angular -->
        <Card client:visible data-aos="fade-up" data-aos-delay="300" className="lg:col-span-4 p-8 flex flex-col group">
          <Techno variant="primary" className="h-full flex flex-col" image={angularLogo} name="Robustesse (Angular)">
            <p>
              Conception d'applications d'entreprise structurées. Une architecture rigoureuse qui assure scalabilité, maintenabilité et sécurité sur le long terme.
            </p>
          </Techno>
        </Card>

      </div>
      <div class="flex h-64">
        <div>
          <Line client:idle/>
        </div>
      </div>
    </div>
  </section>
  <section class=" pt-8">
    <div class="max-width">
      <div class="flex">
        <div>
          <Line client:idle nextTheme="blue" icon={iDevices}/>
        </div>
        <div class="padding pt-0">
          <div class="flex items-center md:flex-row flex-col">
            <div class="left">
              <h2 data-aos="fade-right" class="text-title-large text-tertiary">Développement
                multiplateforme</h2>
              <div data-aos="fade-right" data-aos-delay="100"
                   class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                <h3 class="text-gradient">Touchez un public plus large</h3>
                <p>Je convertis vos idées en applications adaptables à tous les
                  appareils</p>
              </div>
              <p data-aos="fade-right" data-aos-delay="100" class="max-w-prose mt-8 text-body-large">
                Flutter me permet de créer des applications pour
                mobiles, web, bureau et intégrés à partir d'une seule base de code. J'apprécie
                particulièrement
                son efficacité dans le développement multiplateforme, ce qui facilite grandement mon
                travail.</p>

            </div>
          </div>
          <div class="flex flex-wrap gap-y-8 gap-x-12 mt-16 items-start">
            <div data-aos="zoom-in"
                 class=" sm:mt-[42px]  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-tertiary-container/70 text-on-tertiary-container">
              <Icon className="h-16 w-16" icon={iSelectWindow}/>
              <h4>Web</h4>
            </div>
            <div class="sm:flex-2 w-full md:w-fit">
              <div class="flex gap-4 items-center">
                <Divider className="hidden md:block border-primary-container"/>
                <h4 class="text-title-medium text-on-primary-container">Mobile</h4>
                <Divider className="hidden md:block border-primary-container"/>
              </div>
              <div class="flex gap-4 mt-4">
                <Divider orientation="vertical" className="md:hidden border-primary-container"/>
                <div class="flex flex-1 flex-wrap gap-8">
                  <div data-aos="zoom-in" data-aos-delay={150}
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                    <Icon className="h-16 w-16" icon={faApple}/>
                    <p>IOS</p>
                  </div>
                  <div data-aos="zoom-in" data-aos-delay={150}
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                    <Icon className="h-16 w-16" icon={faAndroid}/>
                    <p>Android</p>
                  </div>
                </div>
              </div>

            </div>
            <div class="flex-[3] w-full md:w-fit">
              <div class="flex gap-4 items-center">
                <Divider className="hidden md:block border-secondary-container"/>
                <h4 class="text-title-medium text-on-secondary-container">Desktop</h4>
                <Divider className="hidden md:block border-secondary-container"/>
              </div>
              <div class="flex gap-4 mt-4">
                <Divider orientation="vertical" className="md:hidden border-secondary-container"/>
                <div class="flex flex-1 flex-wrap gap-8">
                  <div data-aos="zoom-in" data-aos-delay={300}
                       class="flex-[100%] lg:flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faWindows}/>
                    <p>Windows</p>
                  </div>
                  <div data-aos="zoom-in" data-aos-delay={300}
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faApple}/>
                    <p>MacOs</p>
                  </div>
                  <div data-aos="zoom-in" data-aos-delay={300}
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faLinux}/>
                    <p>Linux</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <LinearGradient nextTheme="blue"/>
  </section>
</div>