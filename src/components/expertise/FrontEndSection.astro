---
import {Card} from "@components/Card";
import {Techno} from "@components/Techno";
import {Line} from '@components/Line';
import {LinearGradient} from "@components/LinearGradient";
import {Icon, Divider} from "@udixio/ui-react";

import astroLogo from "@assets/images/astro-logo.svg?raw";
import reactLogo from "@assets/images/react-logo.svg?raw";
import angularLogo from "@assets/images/angular-logo.svg?raw";

import {iDevices} from "@udixio/icons-outlined-400/devices";
import {iSelectWindow} from "@udixio/icons-outlined-400/select_window";
import {faAndroid, faApple, faLinux, faWindows} from "@fortawesome/free-brands-svg-icons";
---
<div id="front-end" class="theme-purple bg-surface">
  <section class="max-width padding-x">
    
    <!-- Introduction de Section -->
    <div class="min-h-[50vh] flex flex-col justify-center text-center pt-24 pb-0">
      <h2
        class="text-display-large text-on-surface"
      >
        Ingénierie Front-End.<br/>
        <span class="text-on-surface-variant">La technologie adaptée au produit.</span>
      </h2>
    </div>

    <!-- Connecteur split : ligne reste à gauche + branche va à droite -->
    <div class="relative h-24 md:h-32">
      <Line fromX={0.03} toX={0.03} client:idle nextTheme="purple" />
      <Line fromX={0.03} toX={0.97} client:idle nextTheme="purple" />
    </div>

    <!-- Séquence 1 : Le Duel Structurel -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-32 relative">
      
      <!-- Astro (Left) -->
      <div class="relative pt-8 md:pt-0">
        <Techno variant="primary" name="Astro" image={astroLogo}>
          Performances d'affichage maximales pour les plateformes éditoriales. L'architecture en îlots élimine la charge JavaScript superflue en générant un HTML statique pur. Le contenu est livré instantanément avec un score SEO parfait et une consommation mémoire minimale côté client.
          
          <span class="block mt-6 text-label-medium text-tertiary uppercase tracking-widest font-bold">
            Portfolios • Plateformes éditoriales • Sites institutionnels
          </span>
        </Techno>
      </div>

      <!-- Angular (Right) -->
      <div class="relative">
        <Card client:load className="p-8 md:p-12 w-full h-full">
          <Techno variant="primary" name="Angular" image={angularLogo}>
            Robustesse et prédictibilité pour les systèmes à grande échelle. La compartimentation stricte des modules et l'injection de dépendances sécurisent le produit contre les régressions. Une architecture conçue pour garantir la maintenabilité de bases de code massives destinées à évoluer sur de longues périodes.
            
            <span class="block mt-6 text-label-medium text-tertiary uppercase tracking-widest font-bold">
              Systèmes ERP • Portails bancaires • Apps institutionnelles
            </span>
          </Techno>
        </Card>
      </div>
      
    </div>

    <!-- Connecteur merge : gauche + droite convergent vers le centre -->
    <div class="relative h-24 md:h-32 mt-16 md:mt-32">
      <Line fromX={0.03} toX={0.5} client:idle nextTheme="purple" />
      <Line fromX={0.97} toX={0.5} client:idle nextTheme="purple" />
    </div>

  </section>

  <!-- Séquence 2 : L'Apothéose Immersive (React + Motion) -->
  <div class="w-full bg-gradient-to-b from-surface-container to-surface py-24">
    <div class="max-width padding-x">
      <Card client:load variant="elevated" className="p-8 md:p-16 lg:p-24 overflow-hidden relative">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 relative z-10">
          
          <!-- Colonne Gauche : Identité & Techno -->
          <div class="lg:col-span-5 flex flex-col justify-between">
            <div>
              <Techno variant="primary" name="React & Motion" image={reactLogo}>
                <div class="mt-8 text-label-medium text-tertiary uppercase tracking-widest font-bold">
                  SaaS • Dashboards • Outils métiers
                </div>
              </Techno>
            </div>
            
            <div class="hidden lg:block mt-24">
              <Line client:idle visible={true} />
            </div>
          </div>
          
          <!-- Colonne Droite : Le discours narratif aéré -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            
            <p class="text-headline-medium md:text-display-small text-on-surface mb-12 font-light leading-tight">
              L'animation n'est pas cosmétique. <br/>
              <span class="text-primary italic font-serif">Elle dirige le regard.</span>
            </p>
            
            <p class="text-body-large md:text-title-large text-on-surface-variant leading-relaxed mb-8 max-w-prose">
              Développement d'interfaces hautement interactives où le mouvement guide l'expérience. Masquer intelligemment la latence réseau et valider les actions complexes de l'utilisateur de façon organique.
            </p>
            
            <div class="border-l-2 border-outline-variant pl-8 mt-8">
              <p class="text-title-medium text-on-surface leading-relaxed">
                Le résultat est une interface vivante qui augmente directement la qualité perçue du produit final.
              </p>
            </div>
            
          </div>
          
        </div>
      </Card>
      
      <!-- Ligne de sortie Mobile uniquement -->
      <div class="flex justify-center mt-16 h-32 lg:hidden">
         <Line client:idle />
      </div>
    </div>
  </div>

  <!-- Connecteur return : centre revient à gauche -->
  <div class="max-width padding-x">
    <div class="relative h-24 md:h-32">
      <Line fromX={0.5} toX={0.03} client:idle nextTheme="blue" />
    </div>
  </div>

  <section class=" pt-8">
    <div class="max-width">
      <div class="flex">
        <div>
          <Line client:idle nextTheme="blue" icon={iDevices}/>
        </div>
        <div class="padding pt-0">
          <div class="flex items-center md:flex-row flex-col">
            <div class="left">
              <h2 class="text-title-large text-tertiary">Développement
                multiplateforme</h2>
              <div
                   class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                <h3 class="text-gradient">Touchez un public plus large</h3>
                <p>Je convertis vos idées en applications adaptables à tous les
                  appareils</p>
              </div>
              <p class="max-w-prose mt-8 text-body-large">
                Flutter me permet de créer des applications pour
                mobiles, web, bureau et intégrés à partir d'une seule base de code. J'apprécie
                particulièrement
                son efficacité dans le développement multiplateforme, ce qui facilite grandement mon
                travail.</p>

            </div>
          </div>
          <div class="flex flex-wrap gap-y-8 gap-x-12 mt-16 items-start">
            <div
                 class=" sm:mt-[42px]  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-tertiary-container/70 text-on-tertiary-container">
              <Icon className="h-16 w-16" icon={iSelectWindow}/>
              <h4>Web</h4>
            </div>
            <div class="sm:flex-2 w-full md:w-fit">
              <div class="flex gap-4 items-center">
                <Divider className="hidden md:block border-primary-container"/>
                <h4 class="text-title-medium text-on-primary-container">Mobile</h4>
                <Divider className="hidden md:block border-primary-container"/>
              </div>
              <div class="flex gap-4 mt-4">
                <Divider orientation="vertical" className="md:hidden border-primary-container"/>
                <div class="flex flex-1 flex-wrap gap-8">
                  <div
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                    <Icon className="h-16 w-16" icon={faApple}/>
                    <p>IOS</p>
                  </div>
                  <div
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                    <Icon className="h-16 w-16" icon={faAndroid}/>
                    <p>Android</p>
                  </div>
                </div>
              </div>

            </div>
            <div class="flex-[3] w-full md:w-fit">
              <div class="flex gap-4 items-center">
                <Divider className="hidden md:block border-secondary-container"/>
                <h4 class="text-title-medium text-on-secondary-container">Desktop</h4>
                <Divider className="hidden md:block border-secondary-container"/>
              </div>
              <div class="flex gap-4 mt-4">
                <Divider orientation="vertical" className="md:hidden border-secondary-container"/>
                <div class="flex flex-1 flex-wrap gap-8">
                  <div
                       class="flex-[100%] lg:flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faWindows}/>
                    <p>Windows</p>
                  </div>
                  <div
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faApple}/>
                    <p>MacOs</p>
                  </div>
                  <div
                       class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                    <Icon className="h-16 w-16" icon={faLinux}/>
                    <p>Linux</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <LinearGradient nextTheme="blue"/>
  </section>
</div>