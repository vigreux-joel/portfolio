---
import { Button } from "@udixio/ui-react";
import { Line } from "@components/Line";
import { BackgroundColor } from "@components/BackgroundColor";
import { LinearGradient } from "@components/LinearGradient";

import reactLogo from "@assets/images/react-logo.svg?raw";
import astroLogo from "@assets/images/astro-logo.svg?raw";
import tsLogo from "@assets/images/ts-logo.svg?raw";
import tailwindLogo from "@assets/images/tailwind-logo.svg?raw";

import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iMail } from "@udixio/icons-outlined-400/mail";
import { iInfo } from "@udixio/icons-outlined-400/info";
import { iCode } from "@udixio/icons-outlined-400/code";
import { iApi } from "@udixio/icons-outlined-400/api";
import { iManufacturing } from "@udixio/icons-outlined-400/manufacturing";
import { iDevices } from "@udixio/icons-outlined-400/devices";
import { Icon } from "@udixio/ui-react";
---

<section id="accueil" class="tab-menu relative overflow-hidden">
  <!-- Fond animé spécifique à l'intro -->
  <BackgroundColor
    speed={5_000}
    size="max(50vw, 800px)"
    count={5}
    client:idle
    className="absolute opacity-20 size-full top-0 left-0 -z-10"
  />

  <div class="max-width flex justify-between h-full pt-32 md:pt-42 xl:pt-54">
    <!-- Colonne Timeline (à gauche) & Contenu -->
    <div class="relative z-10 flex flex-col overflow-visible w-full">
      <div class="theme-blue flex flex-col relative">
        <!-- Intro / Hero ancré à la timeline -->
        <div class="flex">
          <div>
            <Line client:load visible isFirst icon={iCode} nextTheme="purple" />
          </div>
          <div class="padding pt-0 pb-16 relative w-full" data-aos="fade-right">
            <h1
              class="text-display-medium xl:text-display-large relative z-10 text-tertiary mb-8"
            >
              Mon <span class="block text-gradient">Expertise Technique</span>
            </h1>
          </div>
        </div>
      </div>

      <div class="flex mt-8">
        <div class="theme-purple not-detect-theme">
          <Line client:idle icon={iCode} isLast />
        </div>
        <div data-aos="fade-right" class="padding pt-0 max-w-screen-lg">
          <h2
            class="text-title-large text-tertiary transition-all duration-1000"
          >
            Développement web - Front-end
          </h2>
          <div
            class="mt-4 text-headline-large md:text-display-medium max-w-prose transition-all duration-1000"
          >
            <h3 class="text-gradient">Performance et flexibilité garantie</h3>
            <p>
              J'assure vos projets avec des technologies modernes et adaptables
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <LinearGradient nextTheme="purple" />
</section>
