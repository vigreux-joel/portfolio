---
import { Line } from "@components/Line";
import { BackgroundColor } from "@components/BackgroundColor";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";

import { iCode } from "@udixio/icons-outlined-400/code";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iApps } from "@udixio/icons-outlined-400/apps";
import { iDevices } from "@udixio/icons-outlined-400/devices";
import { iApi } from "@udixio/icons-outlined-400/api";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
---

<section id="accueil" class="tab-menu relative overflow-hidden theme-blue">
  <BackgroundColor
      speed={7_500}
      size="max(66vw, 800px)"
      count={5}
      client:idle
      className="absolute opacity-20 size-full top-0 left-0 -z-10"
  />
  <div class="max-width flex justify-between h-full pt-32 md:pt-42 xl:pt-54">
    <div class="relative z-10 flex flex-col overflow-visible w-full">

      <div class=" flex flex-col relative">
        <div class="flex">
          <div>
            <Line client:load  isFirst  />
          </div>
          <div class="padding pt-0 pb-16 relative w-full">
            <h1
              class="text-display-medium xl:text-display-large relative z-10  "
            >
              Mon <span class="block text-gradient">Expertise Technique</span>
            </h1>
          </div>
        </div>
      </div>

      <div class="flex mt-8">
        <div>
          <Line client:load icon={iIdCard} nextTheme="purple" />
        </div>
        <div class="padding pt-0">
          <p class="text-body-large max-w-3xl">
            Développeur depuis 2022 et diplômé d'un titre pro Web & Mobile, j'accompagne les entreprises dans la création de leurs outils numériques.</p>
          <p  class=" max-w-3xl mt-8 text-on-surface-variant"> De la conception d'interfaces utilisateurs intuitives à la mise en place en production, je développe des solutions sur-mesure qui répondent à vos enjeux métiers.
          </p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-x-8 gap-y-3 mt-8">
            <a href="#front-end" class="group inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
              <Icon icon={iCode} className="h-5 w-5 text-secondary" />
              <span>Interfaces Web</span>
              <Icon icon={iArrowForward} className="h-4 w-4 text-on-surface-variant opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition-all" />
            </a>
            <a href="#multiplateforme" class="group inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
              <Icon icon={iDevices} className="h-5 w-5 text-primary" />
              <span>Applications Mobiles</span>
              <Icon icon={iArrowForward} className="h-4 w-4 text-on-surface-variant opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition-all" />
            </a>
            <a href="#back-end" class="group inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
              <Icon icon={iApi} className="h-5 w-5 text-primary" />
              <span>APIs & Architecture</span>
              <Icon icon={iArrowForward} className="h-4 w-4 text-on-surface-variant opacity-60 group-hover:opacity-100 group-hover:translate-x-1 transition-all" />
            </a>
          </div>
        </div>
      </div>


    </div>
  </div>

  <LinearGradient className="h-1/2" nextTheme="purple" />
</section>
