---
import { Card } from "@components/Card";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
---

<section class="tab-menu theme-blue  pb-20 md:pb-28">
  <div class="max-width padding-x">
    <Card client:idle variant="outlined">
      <div class="grid gap-8 p-6 md:grid-cols-[auto_1fr_auto] md:items-center md:p-9">
        <span class="grid size-12 place-items-center rounded-2xl bg-primary text-on-primary">
          <Icon icon={iFactCheck} className="size-6" />
        </span>
        <div>
          <p class="sub-title text-secondary">Développement assisté par l’IA</p>
          <h2 class="mt-2 text-headline-medium text-on-surface">
            <span class="block text-gradient">Gagnez du temps sans perdre en qualité.</span>
            Je garde l’IA à sa juste place.
          </h2>
          <p class="mt-4 max-w-3xl text-body-large text-on-surface-variant">
            Découvrez comment j’intègre l’IA au développement sans lui déléguer les
            décisions structurantes ni la responsabilité de ce qui est livré.
          </p>
        </div>
        <Button href="/approche" icon={iArrowForward} iconPosition="right" label="Découvrir mon approche" variant="tonal" />
      </div>
    </Card>
  </div>
</section>
