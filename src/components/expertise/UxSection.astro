---
import { Line } from "@components/Line";
import { FrontEndUxScroll } from "./FrontEndUxScroll";
import { LinearGradient } from "@components/LinearGradient";
---

<div class="theme-cyan">
  <section id="ux" class="reveal-light opacity-50 [.light]:opacity-100 transition-opacity duration-2000 delay-200">
  <!-- Ligne de connexion au-dessus du titre (gauche vers centre) -->
  <div class="max-width">
    <div class="relative h-24 hidden md:block">
      <Line  toX={0.5} client:idle isLast />
    </div>
    <div class="relative h-12 md:hidden">
      <Line  toX={0.5} client:idle isLast />
    </div>
  </div>

  <!-- Titre de la section (centré, suite logique de la ligne) -->
  <div class="max-width padding-x text-center mt-8 mb-12 md:mb-16 ">
    <h2 class="  transition-colors duration-1000 sub-title">Experience utilisateur</h2>
    <h3 class="relative mt-6 text-headline-medium md:text-display-small text-gradient">
   Démarquez votre produit au premier regard
    </h3>
    <p class="  mt-4 text-headline-small md:text-headline-medium max-w-prose mx-auto">
      J'anime vos interfaces avec des animations qui captent l'attention
    </p>
  </div>

  <div class="max-width relative z-20">
    <FrontEndUxScroll client:idle />
  </div>

  <!-- Ligne de connexion en-dessous de la carte -->
  <div class="max-width">
    <div class="relative h-24 hidden md:block">
      <Line fromX={0.5} toX={0.5} client:idle />
    </div>
  </div>

  <!-- Connecteur return : centre revient à gauche -->
  <div class="max-width">
    <div class="relative h-24 md:h-32">
      <Line fromX={0.5} fromPx={0} toX={0} toPx={60} client:idle />
    </div>
  </div>
  <LinearGradient nextTheme="green" />
</section>
</div>
