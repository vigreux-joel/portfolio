---
import {Line} from '@components/Line';
import {LinearGradient} from "@components/LinearGradient";
import {StickyScroll} from "@components/sticky-scroll-reveal";
import {iDevices} from "@udixio/icons-outlined-400/devices";
---
<section id="ux" class="tab-menu theme-purple pt-8 !z-20">
    <div class="max-width">
        <div class="flex">
            <div>
                <Line client:idle icon={iDevices}/>
            </div>
            <div class="padding pt-0">
                <h2 class="text-title-large">Design & Ux</h2>
                <div
                     class="mt-4 text-headline-large md:text-display-medium max-w-prose">
                    <h3 class="text-gradient">Augmentez la fidélité de vos utilisateurs</h3>
                    <p>Offrez une expérience utilisateur exceptionnelle avec mes services</p>
                </div>
            </div>
        </div>
        <StickyScroll client:idle/>
    </div>
    <LinearGradient nextTheme="green"/>
</section>