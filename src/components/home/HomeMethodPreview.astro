---
import { Line } from "@components/Line";
import { Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
---

<div id="methode-preview" class="tab-menu theme-blue bg-surface">
  <section>
    <div class="max-width">
      <div class="flex pt-8">
        <div><Line client:idle icon={iFactCheck} /></div>
        <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
          <h2 class="text-title-large text-tertiary" data-sidebar-label="Méthode">Façon de travailler</h2>
          <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
            <p class="text-gradient">Des étapes courtes.</p>
            <p>Des décisions expliquées.</p>
          </div>
          <div class="mt-8 space-y-5 text-body-large text-on-surface-variant max-w-prose">
            <p>Je commence par clarifier le besoin et ce qui compte vraiment pour les utilisateurs.</p>
            <p>J’utilise des outils d’IA pour gagner du temps, mais chaque choix et chaque livraison restent relus, vérifiés et assumés.</p>
          </div>
        </div>
      </div>

      <div class="padding-x mt-14 mb-20">
        <p class="text-headline-small md:text-headline-medium text-on-surface max-w-5xl">
          Comprendre le besoin <span class="text-tertiary">→</span> choisir l’essentiel <span class="text-tertiary">→</span> construire <span class="text-tertiary">→</span> vérifier <span class="text-tertiary">→</span> transmettre
        </p>
        <a href="/methode" class="group mt-8 inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
          <span>Lire la méthode complète</span>
          <Icon icon={iArrowForward} className="size-4 text-on-surface-variant group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </section>
</div>
