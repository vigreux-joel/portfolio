---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArticle } from "@udixio/icons-outlined-400/article";
import { iCode } from "@udixio/icons-outlined-400/code";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { iSearch } from "@udixio/icons-outlined-400/search";

const steps = [
  {
    number: "01",
    title: "Clarifier",
    description: "Reformuler le besoin, identifier les contraintes et convenir précisément de ce qui doit être livré.",
    icon: iSearch,
  },
  {
    number: "02",
    title: "Découper",
    description: "Organiser le travail en éléments compréhensibles et vérifiables, avec des priorités explicites.",
    icon: iArticle,
  },
  {
    number: "03",
    title: "Construire et vérifier",
    description: "Développer progressivement, relire le code et contrôler les parcours importants avant la livraison.",
    icon: iCode,
  },
  {
    number: "04",
    title: "Transmettre",
    description: "Documenter les décisions utiles pour que la maintenance et les prochaines évolutions restent accessibles.",
    icon: iFactCheck,
  },
];
---

<section id="methode-preview" class="tab-menu theme-blue bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iFactCheck} /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Méthode">Méthode</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Un déroulement lisible,</p>
          <p>du premier échange à la livraison.</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Vous savez à tout moment où en est le projet. Il avance par étapes courtes, les décisions importantes sont expliquées et chaque livraison peut être relue et testée.
        </p>
      </div>
    </div>

    <ol class="padding-x mt-12 grid gap-px overflow-hidden rounded-3xl border border-outline-variant bg-outline-variant sm:grid-cols-2 xl:grid-cols-4">
      {steps.map((step) => (
        <li class="bg-surface-container-low p-7 md:p-8">
          <div class="flex items-center justify-between gap-4">
            <span class="text-label-large text-tertiary">{step.number}</span>
            <Icon icon={step.icon} className="size-6 text-primary" />
          </div>
          <h3 class="mt-10 text-headline-small text-on-surface">{step.title}</h3>
          <p class="mt-4 text-body-large text-on-surface-variant">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="padding-x mt-8 mb-20 md:mb-28">
      <p class="max-w-4xl border-l-2 border-primary pl-5 text-body-large text-on-surface-variant">
        J’utilise des outils d’IA lorsqu’ils accélèrent utilement la recherche ou la production. Leurs propositions restent relues, comprises et vérifiées avant d’être intégrées.
      </p>
      <a href="/methode" class="group mt-8 inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
        <span>Découvrir ma méthode</span>
        <Icon icon={iArrowForward} className="size-4 text-on-surface-variant transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
  <LinearGradient nextTheme="cyan" />
</section>
