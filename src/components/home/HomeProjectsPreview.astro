---
import { getCollection } from "astro:content";
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import ProjectCard from "@components/projects/ProjectCard.astro";
import ProjectFeature from "@components/projects/ProjectFeature.astro";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";

const published = await getCollection("projects", ({ data }) => !data.draft);
const byOrder = (a: (typeof published)[number], b: (typeof published)[number]) =>
  a.data.order - b.data.order;

const feature = published.filter(({ data }) => data.home === "feature").sort(byOrder)[0];
const cards = published.filter(({ data }) => data.home === "card").sort(byOrder);

if (!feature) {
  throw new Error(
    'La page d’accueil attend un projet avec `home: "feature"` dans la collection projects.',
  );
}
---

<section id="projets" class="tab-menu theme-cyan ">
  <div class="max-width">
    <div class="flex pt-8">
      <div class="theme-blue"><Line client:idle icon={iFactCheck} nextTheme="cyan" isLast /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Projets">Projets</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Des projets réels,</p>
          <p>que vous pouvez consulter.</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Chaque projet ci-dessous a été développé, mis en service ou est en cours de
          développement. Aucun n’est une maquette de démonstration.
        </p>
      </div>
    </div>

    <div class="padding-x  mb-20 md:mb-28">
      <ProjectFeature project={feature} />

      {
        cards.length > 0 && (
          <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {cards.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        )
      }

      <Button variant="tonal" href="/projets">
        Voir tous les projets
      </Button>
      <a
        href="/projets"
        class="group mt-8 inline-flex items-center gap-2 text-body-large text-on-surface transition-colors hover:text-primary"
      >
        <span>Voir tous les projets</span>
        <Icon
          icon={iArrowForward}
          className="size-4 text-on-surface-variant transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>

  <LinearGradient nextTheme="blue" />
</section>
