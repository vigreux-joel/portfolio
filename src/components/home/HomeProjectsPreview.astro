---
import { getCollection } from "astro:content";
import { Card } from "@components/Card";
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import ProjectCard from "@components/projects/ProjectCard.astro";
import { sortProjects } from "../../utils/projects";
import { Button } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { BackgroundColor } from "../BackgroundColor";

const published = await getCollection("projects", ({ data }) => !data.draft);
const HOME_PROJECT_LIMIT = 3;
const [primaryProject, ...secondaryProjects] = sortProjects(published).slice(
  0,
  HOME_PROJECT_LIMIT,
);
---

<section id="projets" class="tab-menu theme-cyan ">
  <BackgroundColor
      speed={9_000}
      size="max(66vw, 800px)"
      count={4}
      client:idle
      className="absolute inset-0 h-1/2 -z-10 top-1/4  opacity-20"
  />
  <div class="max-width">
    <div class="flex pt-8">
      <div class="theme-cyan"><Line client:idle icon={iFactCheck}  isLast /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <p class="sub-title" data-sidebar-label="Projets">Projets</p>
        <h2 class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <span class="block text-gradient">Voyez ce que je réalise concrètement.</span>
          <span class="block">Je présente des projets réels, pas des maquettes.</span>
        </h2>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Chaque projet ci-dessous a été développé, mis en service ou est en cours de
          développement. Aucun n’est une maquette de démonstration.
        </p>
      </div>
    </div>

    <div class="section py-0">
      {primaryProject && <ProjectCard project={primaryProject} />}

      {
        secondaryProjects.length > 0 && (
          <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {secondaryProjects.map((project) => (
              <ProjectCard
                project={project}
                primaryButtonVariant="text"
              />
            ))}

            <Card
              client:idle
              variant="filled"
              className="group relative z-10 flex h-full min-h-72 flex-col bg-surface-container-highest/90 px-8 py-6"
            >
              <span class="sub-title text-secondary">Tous les projets</span>
              <h3 class="mt-4 text-headline-small text-on-surface">
                Découvrez mes autres réalisations.
              </h3>
              <div class="mt-auto pt-8">
                <Button
                  href="/projets"
                  label="Voir tous les projets"
                  icon={iArrowForward}
                  iconPosition="right"
                  variant="tonal"
                />
              </div>
            </Card>
          </div>
        )
      }
    </div>
  </div>

  <LinearGradient nextTheme="blue" />
</section>
