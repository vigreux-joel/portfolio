---
import { getCollection } from "astro:content";
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { ProjectsCarousel, type ProjectSlide } from "./ProjectsCarousel";

const entries = await getCollection("projects", ({ data }) => data.featured && !data.draft);
const projects: ProjectSlide[] = entries
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({
    id,
    title: data.title,
    eyebrow: data.eyebrow,
    headline: data.headline,
    cover: data.cover,
  }));
---

<section id="projets" class="tab-menu theme-cyan bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iFactCheck} nextTheme="cyan" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Projets">Projets sélectionnés</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
          <p class="text-gradient">Des réalisations à ouvrir,</p>
          <p>tester et parcourir.</p>
        </div>
      </div>
    </div>

    <div class="padding-x mt-14">
      <ProjectsCarousel projects={projects} client:visible />
    </div>

    <div class="flex h-24 md:h-32"><div><Line client:idle /></div></div>
  </div>
  <LinearGradient nextTheme="green" />
</section>
