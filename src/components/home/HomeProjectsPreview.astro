---
import { getCollection } from "astro:content";
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { iCheckCircle } from "@udixio/icons-outlined-400/check_circle";

const projects = await getCollection("projects", ({ id, data }) => id === "udixio-ui" && !data.draft);
const project = projects[0];

if (!project) {
  throw new Error("Le projet Udixio UI est nécessaire à la page d’accueil.");
}

const proofs = [
  "Composants réutilisables et typés",
  "Thèmes générés à partir d’une couleur",
  "États cohérents au clavier, à la souris et au toucher",
  "Documentation maintenue avec la bibliothèque",
];
---

<section id="projets" class="tab-menu theme-cyan bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iFactCheck} nextTheme="cyan" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Projet phare">Projet phare</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Une bibliothèque utilisée ici,</p>
          <p>pas une simple maquette.</p>
        </div>
      </div>
    </div>

    <div class="padding-x mt-12 mb-20 md:mb-28">
      <article class="overflow-hidden rounded-3xl border border-outline-variant bg-surface-container-low">
        <div class="grid lg:grid-cols-[1.08fr_.92fr]">
          <div class="min-h-72 bg-surface-container">
            <img
              src={project.data.cover.src}
              alt={project.data.cover.alt}
              width={project.data.cover.width}
              height={project.data.cover.height}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>

          <div class="p-7 md:p-10 lg:p-12">
            <p class="text-label-large text-tertiary">{project.data.eyebrow}</p>
            <h3 class="mt-3 text-headline-large text-on-surface">{project.data.title}</h3>
            <p class="mt-4 text-headline-small text-on-surface">
              Une base commune pour construire des interfaces cohérentes.
            </p>
            <p class="mt-6 text-body-large text-on-surface-variant">
              Depuis 2024, je développe cette bibliothèque avec React, TypeScript et Material 3. J’en ai défini l’architecture des composants, les API et le système de thèmes.
            </p>
            <p class="mt-4 text-body-large text-on-surface-variant">
              Le portfolio que vous consultez l’utilise directement&nbsp;: la bibliothèque est confrontée à un usage réel et continue d’évoluer avec lui.
            </p>

            <ul class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Caractéristiques d’Udixio UI">
              {proofs.map((proof) => (
                <li class="flex items-start gap-3 text-body-medium text-on-surface-variant">
                  <Icon icon={iCheckCircle} className="mt-0.5 size-5 shrink-0 text-primary" />
                  <span>{proof}</span>
                </li>
              ))}
            </ul>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
              <Button href={`/projets/${project.id}`} icon={iArrowForward} label="Voir l’étude de cas" />
              {project.data.externalUrl && (
                <Button href={project.data.externalUrl} icon={iArrowOutward} label="Ouvrir Udixio UI" variant="outlined" />
              )}
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>

  <LinearGradient nextTheme="green" />
</section>
