---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";
import { iWork } from "@udixio/icons-outlined-400/work";
import { iCode } from "@udixio/icons-outlined-400/code";
import { iCloud } from "@udixio/icons-outlined-400/cloud";
import { iSync } from "@udixio/icons-outlined-400/sync";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
---

<section id="experience" class="tab-menu theme-green bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iWork} nextTheme="green" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Expérience">
          Expérience en production
        </h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Plus de trois années</p>
          <p>à faire évoluer un SaaS.</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Chez Netsimpler, j’ai contribué au développement d’une plateforme de création de sites web, côté interface comme côté services.
        </p>
      </div>
    </div>

    <div class="padding-x mt-12 grid gap-px overflow-hidden rounded-3xl border border-outline-variant bg-outline-variant md:grid-cols-3">
      <article class="bg-surface-container-low p-7 md:p-8">
        <Icon icon={iCode} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Front-end</p>
        <h3 class="mt-2 text-headline-small text-on-surface">Une base modernisée progressivement</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          Développement avec Astro, React, Angular et TypeScript, puis migration progressive du front-end Angular vers Astro et React.
        </p>
      </article>

      <article class="bg-surface-container-low p-7 md:p-8">
        <Icon icon={iCloud} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Back-end</p>
        <h3 class="mt-2 text-headline-small text-on-surface">Des services au cœur du produit</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          Authentification, gestion de données et traitements serverless, avec une évolution du back-end vers des services AWS ciblés.
        </p>
      </article>

      <article class="bg-surface-container-low p-7 md:p-8">
        <Icon icon={iSync} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Continuité</p>
        <h3 class="mt-2 text-headline-small text-on-surface">Faire évoluer sans repartir de zéro</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          Une expérience concrète du code en production, des migrations progressives et des choix techniques que plusieurs personnes doivent pouvoir reprendre.
        </p>
      </article>
    </div>

    <div class="padding-x mt-8 mb-20 md:mb-28">
      <a href="/profil" class="group inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
        <span>Consulter le parcours complet</span>
        <Icon icon={iArrowForward} className="size-4 text-on-surface-variant transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <LinearGradient nextTheme="cyan" />
</section>
