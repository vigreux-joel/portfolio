---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iAutorenew } from "@udixio/icons-outlined-400/autorenew";
import { iGroups } from "@udixio/icons-outlined-400/groups";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iLightbulb } from "@udixio/icons-outlined-400/lightbulb";
import { iRoute } from "@udixio/icons-outlined-400/route";
---

<section id="situation" class="tab-menu theme-green bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iRoute} nextTheme="green" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Situation">Votre situation</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Faire avancer votre projet,</p>
          <p>quel que soit son point de départ.</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Un projet web bloque rarement pour des raisons techniques uniquement. Voici les trois
          situations dans lesquelles j’interviens le plus souvent, et ce que je fais concrètement
          dans chacune.
        </p>
      </div>
    </div>

    <div class="padding-x mt-12 grid gap-px overflow-hidden rounded-3xl border border-outline-variant bg-outline-variant md:grid-cols-3">
      <article class="flex flex-col bg-surface-container-low p-7 md:p-8">
        <Icon icon={iLightbulb} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Vous partez d’une idée ou de maquettes</p>
        <h3 class="mt-2 text-headline-small text-on-surface">Une première version en ligne</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          La crainte habituelle est que le projet s’étire sans jamais aboutir. Nous définissons
          d’abord le périmètre minimum qui a du sens, puis j’avance par livraisons courtes que
          vous pouvez vérifier au fur et à mesure.
        </p>
      </article>

      <article class="flex flex-col bg-surface-container-low p-7 md:p-8">
        <Icon icon={iAutorenew} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Votre application existe mais n’avance plus</p>
        <h3 class="mt-2 text-headline-small text-on-surface">Reprendre sans tout casser</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          Je ne propose pas une réécriture par principe. Je commence par comprendre la base de
          code et ses contraintes, puis j’ajoute la fonctionnalité, corrige le point bloquant ou
          engage une migration progressive, en gardant le produit utilisable.
        </p>
      </article>

      <article class="flex flex-col bg-surface-container-low p-7 md:p-8">
        <Icon icon={iGroups} className="size-7 text-primary" />
        <p class="mt-8 text-label-large text-tertiary">Votre équipe a besoin de renfort</p>
        <h3 class="mt-2 text-headline-small text-on-surface">M’intégrer à ce qui existe déjà</h3>
        <p class="mt-4 text-body-large text-on-surface-variant">
          Je reprends vos outils, vos conventions et votre rythme plutôt que d’imposer les miens.
          Les décisions importantes sont partagées et documentées, pour que ma contribution reste
          compréhensible après mon départ.
        </p>
        <a
          href="/profil"
          class="group mt-6 inline-flex items-center gap-2 self-start text-body-medium text-on-surface transition-colors hover:text-primary"
        >
          <Icon icon={iIdCard} className="size-4 text-on-surface-variant" />
          <span>Consulter mon CV</span>
        </a>
      </article>
    </div>

    <div class="padding-x mt-8 mb-20 md:mb-28">
      <a
        href="/expertise"
        class="group inline-flex items-center gap-2 text-body-large text-on-surface transition-colors hover:text-primary"
      >
        <span>Voir mon expertise technique</span>
        <Icon
          icon={iArrowForward}
          className="size-4 text-on-surface-variant transition-transform group-hover:translate-x-1"
        />
      </a>
    </div>
  </div>

  <LinearGradient nextTheme="cyan" />
</section>
