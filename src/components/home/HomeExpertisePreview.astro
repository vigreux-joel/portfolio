---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";
import { iApi } from "@udixio/icons-outlined-400/api";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iCode } from "@udixio/icons-outlined-400/code";
import { iDevices } from "@udixio/icons-outlined-400/devices";
---

<div id="expertise-preview" class="tab-menu theme-purple bg-surface">
  <section>
    <div class="max-width">
      <div class="flex pt-8">
        <div><Line client:idle icon={iCode} nextTheme="purple" /></div>
        <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
          <h2 class="text-title-large text-tertiary" data-sidebar-label="Expertise">Ce que je peux prendre en charge</h2>
          <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
            <p class="text-gradient">Un seul interlocuteur,</p>
            <p>de l’écran à la mise en ligne.</p>
          </div>
        </div>
      </div>

      <div class="relative h-20 md:h-28 hidden md:block">
        <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle />
        <Line fromX={0} fromPx={60} toX={0.5} toPx={76} client:idle />
      </div>

      <div class="grid md:grid-cols-2 gap-x-8 gap-y-12 mt-8">
        <div class="flex">
          <div><Line client:idle icon={iDevices} isLast /></div>
          <div class="padding pt-8 md:pt-0">
            <span class="block text-title-medium text-tertiary">L’expérience visible</span>
            <h3 class="text-headline-small md:text-headline-medium mt-2">Un produit simple à utiliser</h3>
            <p class="max-w-prose mt-4 text-body-large text-on-surface-variant">
              Des pages claires, rapides sur mobile comme sur ordinateur, et accessibles.
            </p>
            <p class="max-w-prose mt-5 text-body-medium text-on-surface-variant">
              Selon le projet&nbsp;: Astro, React ou Angular.
            </p>
          </div>
        </div>
        <div class="flex">
          <div><Line client:idle icon={iApi} /></div>
          <div class="padding pt-8 md:pt-0">
            <span class="block text-title-medium text-tertiary">Le fonctionnement en coulisses</span>
            <h3 class="text-headline-small md:text-headline-medium mt-2">Une base fiable</h3>
            <p class="max-w-prose mt-4 text-body-large text-on-surface-variant">
              Comptes, données, automatisations et échanges avec d’autres services&nbsp;: tout ce qui doit fonctionner sans être visible.
            </p>
            <p class="max-w-prose mt-5 text-body-medium text-on-surface-variant">
              Principalement avec TypeScript et NestJS.
            </p>
          </div>
        </div>
      </div>

      <div class="padding-x mt-12">
        <a href="/expertise" class="group inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary transition-colors">
          <span>Voir mes compétences en détail</span>
          <Icon icon={iArrowForward} className="size-4 text-on-surface-variant group-hover:translate-x-1 transition-transform" />
        </a>
      </div>

      <div class="relative h-20 md:h-28 hidden md:block">
        <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle isFirst />
        <Line fromX={0.5} fromPx={76} toX={0} toPx={60} client:idle />
      </div>
      <div class="flex h-20 md:h-28"><div><Line client:idle /></div></div>
    </div>
  </section>
  <LinearGradient nextTheme="blue" />
</div>
