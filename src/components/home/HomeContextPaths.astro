---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArticle } from "@udixio/icons-outlined-400/article";
import { iCode } from "@udixio/icons-outlined-400/code";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iRoute } from "@udixio/icons-outlined-400/route";
import { iSearch } from "@udixio/icons-outlined-400/search";

const steps = [
  {
    number: "01",
    title: "Clarifier",
    description: "Reformuler le besoin et convenir précisément de ce qui doit être livré.",
    icon: iSearch,
  },
  {
    number: "02",
    title: "Découper",
    description: "Organiser le travail en étapes compréhensibles, vérifiables et prioritaires.",
    icon: iArticle,
  },
  {
    number: "03",
    title: "Construire et vérifier",
    description: "Développer progressivement, relire le code et tester les parcours importants.",
    icon: iCode,
  },
  {
    number: "04",
    title: "Transmettre",
    description: "Documenter les décisions utiles pour faciliter la maintenance et les évolutions.",
    icon: iFactCheck,
  },
];
---

<section id="travailler-ensemble" class="tab-menu  ">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iRoute} /></div>
      <div class="padding pt-0 pb-8 flex flex-col justify-center max-w-7xl">
        <p class="sub-title text-secondary" data-sidebar-label="Collaboration">Travailler ensemble</p>
        <h2 class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <span class="text-gradient block">Un projet à réaliser</span>
          ou une équipe à renforcer.
        </h2>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Deux façons de démarrer, selon que vous portez un projet ou que vous cherchez à renforcer une équipe.
        </p>
      </div>
    </div>

    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle />
      <Line fromX={0} fromPx={60} toX={0.5} toPx={76} client:idle />
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-12 mt-8">
      <article class="flex">
        <div><Line client:idle icon={iRoute}  /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-secondary">Pour un projet</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Créer, compléter ou reprendre une application</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Première version à mettre en ligne, fonctionnalité à ajouter ou base existante à reprendre&nbsp;: le travail avance par livraisons courtes que vous pouvez vérifier.
          </p>
          <div class="mt-8">
            <Button href="/contact" icon={iArrowForward} label="Présenter votre projet" />
          </div>
        </div>
      </article>

      <article class="flex">
        <div><Line client:idle icon={iIdCard} /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-secondary">Pour une équipe</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Contribuer dans une organisation existante</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Mon CV détaille le parcours, les technologies pratiquées et les missions menées en production.
          </p>
          <div class="mt-8">
            <Button href="/profil" icon={iIdCard} label="Consulter mon CV · PDF" variant="tonal" />
          </div>
        </div>
      </article>
    </div>

    <div class="padding-x mt-16 md:mt-20">
      <div class="max-w-3xl">
        <p class="sub-title text-secondary">Déroulement</p>
        <h3 class="mt-3 text-headline-medium md:text-headline-large">
          Un cadre clair pour avancer sans tunnel opaque.
        </h3>
        <p class="mt-5 text-body-large text-on-surface-variant">
          Vous savez où en est le travail, ce qui a été décidé et ce qui sera vérifié avant la prochaine livraison.
        </p>
      </div>

      <ol class="mt-10 grid gap-px overflow-hidden rounded-3xl bg-outline-variant/50 sm:grid-cols-2 xl:grid-cols-4">
        {steps.map((step) => (
          <li class="bg-surface-container-low p-6 md:p-7">
            <div class="flex items-center justify-between gap-4">
              <span class="text-label-large text-secondary">{step.number}</span>
              <Icon icon={step.icon} className="size-5 text-primary" />
            </div>
            <h4 class="mt-8 text-title-large text-on-surface">{step.title}</h4>
            <p class="mt-3 text-body-medium text-on-surface-variant">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle  />
      <Line fromX={0.5} fromPx={76} toX={0} toPx={60} client:idle />
    </div>
  </div>

  <LinearGradient nextTheme="cyan" />
</section>
