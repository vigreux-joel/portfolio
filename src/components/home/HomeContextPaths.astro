---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iRoute } from "@udixio/icons-outlined-400/route";
---

<section id="travailler-ensemble" class="tab-menu theme-green bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iRoute} nextTheme="green" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Travailler ensemble">Travailler ensemble</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
          <p class="text-gradient">Un projet à prendre en main</p>
          <p>ou une équipe à renforcer.</p>
        </div>
      </div>
    </div>

    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle />
      <Line fromX={0} fromPx={60} toX={0.5} toPx={76} client:idle />
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-12 mt-8">
      <article class="flex">
        <div><Line client:idle icon={iRoute} isLast /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-tertiary">Confier un projet</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Créer, améliorer ou reprendre un produit web</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Je cadre le besoin, construis la solution et vous accompagne jusqu’à sa mise en ligne.
          </p>
          <a href="/developpement-produit" class="group mt-7 inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary">
            <span>Voir l’accompagnement produit</span>
            <Icon icon={iArrowForward} className="size-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>

      <article class="flex">
        <div><Line client:idle icon={iIdCard} /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-tertiary">Renforcer une équipe</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Intégrer un développeur full-stack à votre organisation</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Je rejoins vos outils, vos habitudes et votre rythme pour faire avancer le produit avec l’équipe en place.
          </p>
          <a href="/profil" class="group mt-7 inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary">
            <span>Consulter mon CV</span>
            <Icon icon={iArrowForward} className="size-4 group-hover:translate-x-1 transition-transform" />
          </a>
        </div>
      </article>
    </div>

    <div class="relative h-16 md:h-20 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle isFirst />
      <Line fromX={0.5} fromPx={76} toX={0} toPx={60} client:idle />
    </div>
  </div>
  <LinearGradient nextTheme="cyan" />
</section>
