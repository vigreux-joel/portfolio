---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Button } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
import { iRoute } from "@udixio/icons-outlined-400/route";
---

<section id="travailler-ensemble" class="tab-menu theme-cyan bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iRoute} nextTheme="cyan" /></div>
      <div class="padding pt-0 flex flex-col justify-center max-w-7xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Collaboration">Travailler ensemble</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-5xl">
          <p class="text-gradient">Un projet à réaliser</p>
          <p>ou une équipe à renforcer.</p>
        </div>
        <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
          Deux façons de démarrer, selon que vous portez un projet ou que vous cherchez à renforcer une équipe.
        </p>
      </div>
    </div>

    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle />
      <Line fromX={0} fromPx={60} toX={0.5} toPx={76} client:idle />
    </div>

    <div class="grid md:grid-cols-2 gap-x-8 gap-y-12 mt-8">
      <article class="flex">
        <div><Line client:idle icon={iRoute} isLast /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-tertiary">Pour un projet</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Créer, compléter ou reprendre une application</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Présentez-moi ce qui existe, l’objectif visé et ce qui bloque aujourd’hui. Je vous réponds avec les premières questions utiles et la prochaine étape concrète.
          </p>
          <div class="mt-8">
            <Button href="/contact" icon={iArrowForward} label="Présenter votre projet" />
          </div>
        </div>
      </article>

      <article class="flex">
        <div><Line client:idle icon={iIdCard} /></div>
        <div class="padding pt-8 md:pt-0">
          <span class="block text-title-medium text-tertiary">Pour une équipe</span>
          <h3 class="mt-2 text-headline-small md:text-headline-medium">Contribuer dans une organisation existante</h3>
          <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
            Mon CV détaille le parcours, les technologies pratiquées et les missions menées en production.
          </p>
          <div class="mt-8">
            <Button href="/profil" icon={iIdCard} label="Consulter mon CV · PDF" variant="outlined" />
          </div>
        </div>
      </article>
    </div>

    <div class="relative h-20 md:h-28 hidden md:block">
      <Line fromX={0} fromPx={60} toX={0} toPx={60} client:idle isFirst />
      <Line fromX={0.5} fromPx={76} toX={0} toPx={60} client:idle />
    </div>
  </div>

  <LinearGradient nextTheme="blue" />
</section>
