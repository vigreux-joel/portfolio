---
import { BackgroundColor } from "@components/BackgroundColor";
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
---

<section id="accueil" class="tab-menu relative overflow-hidden theme-blue">
  <BackgroundColor
    speed={7_500}
    size="max(66vw, 800px)"
    count={5}
    client:idle
    className="absolute opacity-20 size-full top-0 left-0 -z-10"
  />

  <div class="max-width flex justify-between h-full pt-32 md:pt-42 xl:pt-54">
    <div class="relative z-10 flex flex-col overflow-visible w-full">
      <div class="flex">
        <div>
          <Line client:load isFirst />
        </div>
        <div class="padding pt-0 pb-16 relative w-full">
          <p class="text-title-large text-tertiary mb-5">Joël Vigreux</p>
          <h1 class="text-display-medium xl:text-display-large relative z-10">
            Développeur
            <span class="block text-gradient">full-stack.</span>
          </h1>
        </div>
      </div>

      <div class="flex mt-8">
        <div>
          <Line client:load icon={iIdCard} nextTheme="purple" />
        </div>
        <div class="padding pt-0">
          <p class="text-headline-small max-w-3xl">
            Je crée des sites et des applications web simples à utiliser, rapides et solides dans le temps.
          </p>
          <p class="max-w-2xl mt-6 text-body-large text-on-surface-variant">
            Je peux partir d’une idée, améliorer un produit existant ou reprendre un projet devenu difficile à faire évoluer.
          </p>
        </div>
      </div>
    </div>
  </div>

  <LinearGradient className="h-1/2" nextTheme="purple" />
</section>
