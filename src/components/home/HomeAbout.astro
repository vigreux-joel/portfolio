---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Image } from "astro:assets";
import { Icon } from "@udixio/ui-react";
import photo from "@assets/images/photo.png";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iIdCard } from "@udixio/icons-outlined-400/id_card";
---

<section id="a-propos" class="tab-menu theme-purple bg-surface">
  <div class="max-width">
    <div class="flex pt-8">
      <div><Line client:idle icon={iIdCard} nextTheme="green" /></div>
      <div class="padding pt-0 w-full">
        <div class="grid lg:grid-cols-[1fr_280px] gap-12 lg:gap-20 items-start">
          <div>
            <h2 class="text-title-large text-tertiary" data-sidebar-label="À propos">À propos</h2>
            <div class="mt-4 text-headline-large md:text-display-small max-w-prose">
              <p class="text-gradient">Je conçois le projet.</p>
              <p>Je développe le produit.</p>
            </div>
            <p class="mt-8 text-body-large text-on-surface-variant max-w-2xl">
              Du premier échange à la mise en ligne, vous discutez directement avec moi. J’explique les choix, les limites et les prochaines étapes sans imposer de jargon.
            </p>

            <dl class="mt-10 grid sm:grid-cols-3 gap-x-8 gap-y-6 max-w-3xl">
              <div class="border-t border-outline-variant pt-4">
                <dt class="text-label-large text-tertiary">Expérience</dt>
                <dd class="mt-2 text-body-large text-on-surface">Professionnelle depuis 2021</dd>
              </div>
              <div class="border-t border-outline-variant pt-4">
                <dt class="text-label-large text-tertiary">Formation</dt>
                <dd class="mt-2 text-body-large text-on-surface">Diplômé en développement web et mobile</dd>
              </div>
              <div class="border-t border-outline-variant pt-4">
                <dt class="text-label-large text-tertiary">Localisation</dt>
                <dd class="mt-2 text-body-large text-on-surface">Béthune · à distance</dd>
              </div>
            </dl>

            <a href="https://linkedin.com/in/vigreux-joel" target="_blank" rel="me noopener noreferrer" class="group mt-8 inline-flex items-center gap-2 text-body-large text-on-surface hover:text-primary">
              <span>Voir mon parcours</span>
              <Icon icon={iArrowForward} className="size-4 group-hover:translate-x-1 transition-transform" />
              <span class="sr-only">(nouvel onglet)</span>
            </a>
          </div>

          <figure>
            <Image
              src={photo}
              alt="Portrait de Joël Vigreux"
              widths={[240, 360, 560]}
              sizes="(min-width: 1024px) 280px, 60vw"
              format="webp"
              class="w-full max-w-70 aspect-[4/5] object-cover rounded-3xl"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </div>
      </div>
    </div>

    <div class="flex h-20 md:h-28"><div><Line client:idle /></div></div>
  </div>
  <LinearGradient nextTheme="green" />
</section>
