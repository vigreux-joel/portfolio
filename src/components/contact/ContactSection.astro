---
import {Icon} from "@udixio/ui-react";
import {Card} from "@components/Card";
import {BackgroundColor} from "@components/BackgroundColor";
import {FormContact} from "@components/FormContact";
import {faLinkedin} from "@fortawesome/free-brands-svg-icons";
import {iMail} from "@udixio/icons-outlined-400/mail";
import {iCall} from "@udixio/icons-outlined-400/call";
import {iLocationOn} from "@udixio/icons-outlined-400/location_on";

const email = import.meta.env.PUBLIC_EMAIL_TO || "contact@vigreux-joel.fr";
const emailSubject = encodeURIComponent("Nouveau projet de développement web");
const emailBody = encodeURIComponent(
    "Bonjour Joël,\n\nJe vous contacte concernant...\n\nCordialement,",
);
const mailtoHref = `mailto:${email}?subject=${emailSubject}&body=${emailBody}`;

const phone = import.meta.env.PUBLIC_PHONE;
const phoneHref = phone?.replace(/\s/g, "");
// +33612345678 se lit mal : on l'affiche groupé par deux, comme on le dicte.
const phoneLabel = phoneHref?.replace(
    /^\+33(\d)(\d{2})(\d{2})(\d{2})(\d{2})$/,
    "+33 $1 $2 $3 $4 $5",
);

const linkedin = "https://linkedin.com/in/vigreux-joel";
---

<section id="contact" class="tab-menu min-h-screen flex items-center theme-blue pt-32 md:pt-42 xl:pt-54 pb-20 md:pb-28">
    <BackgroundColor
            speed={7_000}
            size="max(66vw, 800px)"
            count={5}
            client:idle
            className="absolute inset-x-0 top-0 -z-10 h-[46rem] opacity-20"
    />

    <div class="max-width padding-x">
        <div class="mx-auto max-w-3xl text-center">
            <h1 class="text-display-medium">
                <span class="block">Dites-moi ce qui vous amène.</span>
                <span class="block text-gradient">Je prends le temps de vous répondre.</span>
            </h1>
            <p class="mt-6 text-body-large text-on-surface-variant">
                Le contexte, ce qui existe déjà et ce que vous cherchez à obtenir.
                Quelques lignes suffisent, je réponds sous 48 h ouvrées.
            </p>
        </div>

        <!-- items-stretch : les deux cartes partagent la hauteur de la plus haute. -->
        <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
            <!-- Le formulaire passe en premier dans le DOM : sur mobile il arrive
                 directement sous le titre, sans la carte de repli au-dessus. -->
            <div class="min-w-0 lg:order-2 lg:col-span-8">
                <Card
                        client:visible
                        variant="filled"
                        className="h-full ring-1 ring-primary/30"
                >
                    <div class="p-6 md:p-8 h-full flex flex-col">
                        <h2 class="text-title-large">Votre message</h2>
                        <p class="mt-2 text-body-medium text-on-surface-variant max-w-prose">
                            Trois champs suffisent. Je lis chaque demande moi-même.
                        </p>
                        <FormContact client:visible/>
                    </div>
                </Card>
            </div>

            <aside class="min-w-0 lg:order-1 lg:col-span-4">
                <Card
                        client:visible
                        variant="filled"
                        pointerGlow={false}
                        className="h-full bg-surface-container-high/50"
                >
                    <div class="p-6 h-full flex flex-col">
                        <h2 class="text-title-large">Me joindre directement</h2>

                        <div class="mt-6 flex flex-col gap-5">
                            <a class="group flex items-center gap-4" href={mailtoHref}>
                                <span class="grid place-items-center size-10 shrink-0 rounded-2xl bg-primary-container text-on-primary-container">
                                    <Icon icon={iMail} className="size-5"/>
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-title-small">Email</span>
                                    <span class="mt-0.5 block break-words text-body-medium text-on-surface-variant underline underline-offset-4 transition-colors group-hover:text-primary">
                                        {email}
                                    </span>
                                </span>
                            </a>

                            {phone && (
                                    <a class="group flex items-center gap-4" href={`tel:${phoneHref}`}>
                                        <span class="grid place-items-center size-10 shrink-0 rounded-2xl bg-secondary-container text-on-secondary-container">
                                            <Icon icon={iCall} className="size-5"/>
                                        </span>
                                        <span class="min-w-0">
                                            <span class="block text-title-small">Téléphone</span>
                                            <span class="mt-0.5 block text-body-medium text-on-surface-variant underline underline-offset-4 transition-colors group-hover:text-primary">
                                                {phoneLabel}
                                            </span>
                                        </span>
                                    </a>
                            )}

                            <div class="flex items-center gap-4">
                                <span class="grid place-items-center size-10 shrink-0 rounded-2xl bg-tertiary-container text-on-tertiary-container">
                                    <Icon icon={iLocationOn} className="size-5"/>
                                </span>
                                <span class="min-w-0">
                                    <span class="block text-title-small">Mobilité</span>
                                    <span class="mt-0.5 block text-body-medium text-on-surface-variant">
                                        Amiens et Lille · à distance
                                    </span>
                                </span>
                            </div>
                        </div>

                        <a
                                class="group mt-auto flex items-center gap-4 border-t border-outline-variant pt-6"
                                href={linkedin}
                                target="_blank"
                                rel="me noopener noreferrer"
                        >
                            <span class="grid place-items-center size-10 shrink-0 rounded-2xl bg-surface-container-high text-on-surface-variant">
                                <Icon icon={faLinkedin} className="size-5"/>
                            </span>
                            <span class="min-w-0">
                                <span class="block text-title-small">LinkedIn</span>
                                <span class="mt-0.5 block text-body-medium text-on-surface-variant underline underline-offset-4 transition-colors group-hover:text-primary">
                                    Voir le profil<span class="sr-only"> (nouvel onglet)</span>
                                </span>
                            </span>
                        </a>
                    </div>
                </Card>
            </aside>
        </div>
    </div>
</section>
