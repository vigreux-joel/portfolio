---
import {BackgroundColor} from "@components/BackgroundColor";
import {Line} from "@components/Line";
---

<section id="contact" class="tab-menu theme-blue pt-32 md:pt-42 xl:pt-54">
    <BackgroundColor
            speed={7_000}
            size="max(66vw, 800px)"
            count={5}
            client:idle
            className="absolute inset-x-0 top-0 -z-10 h-[46rem] opacity-20"
    />
    <div class="max-width">
        <div class="flex">
            <div><Line client:load isFirst/></div>
            <div class="padding pt-0 pb-16">
                <h1 class="mt-5 text-display-medium max-w-5xl">
                    <span class="block">Dites-moi ce qui vous amène.</span>
                    <span class="block text-gradient">Je prends le temps de vous répondre.</span>
                </h1>
                <p class="mt-8 text-body-large text-on-surface-variant max-w-3xl">
                    Un projet à cadrer, une question technique ou simplement l’envie
                    d’échanger. Choisissez le canal qui vous convient, je réponds
                    généralement sous 48 h ouvrées.
                </p>
            </div>
        </div>
    </div>
</section>
