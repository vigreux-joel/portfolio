---
import {Icon} from "@udixio/ui-react";
import {Card} from "@components/Card";
import {Line} from "@components/Line";
import {FormContact} from "@components/FormContact";
import {faGithub, faLinkedin} from "@fortawesome/free-brands-svg-icons";
import {iMail} from "@udixio/icons-outlined-400/mail";
import {iCall} from "@udixio/icons-outlined-400/call";
import {iLocationOn} from "@udixio/icons-outlined-400/location_on";

const email = import.meta.env.PUBLIC_EMAIL_TO || "contact@vigreux-joel.fr";
const emailSubject = encodeURIComponent("Nouveau projet de développement web");
const emailBody = encodeURIComponent(
    "Bonjour Joël,\n\nJe vous contacte concernant...\n\nCordialement,",
);
const mailtoHref = `mailto:${email}?subject=${emailSubject}&body=${emailBody}`;

const phone = import.meta.env.PUBLIC_PHONE;
const phoneHref = phone?.replace(/\s/g, "");
// +33612345678 se lit mal : on l'affiche groupé par deux, comme on le dicte.
const phoneLabel = phoneHref?.replace(
    /^\+33(\d)(\d{2})(\d{2})(\d{2})(\d{2})$/,
    "+33 $1 $2 $3 $4 $5",
);

const linkedin = "https://linkedin.com/in/vigreux-joel";
const github = "https://github.com/vigreux-joel";
---

<section class="tab-menu">
    <div class="max-width">
        <div class="flex mt-8">
            <div><Line client:idle icon={iMail} isLast/></div>
            <div class="padding pt-0 pb-16 flex-1">
                <div class="max-w-7xl">
                    <p class="sub-title" data-sidebar-label="Contact">Premier échange</p>
                    <h2 class="mt-4 text-headline-large md:text-display-small max-w-5xl">
                        <span class="block text-gradient">Quelques mots suffisent pour commencer.</span>
                        <span class="block">Nous préciserons le reste ensemble.</span>
                    </h2>
                </div>
            </div>
        </div>

        <div class="padding-x grid items-stretch gap-6 lg:grid-cols-12">
            <div class="lg:col-span-5 min-w-0">
                <Card
                        client:visible
                        variant="filled"
                        energyX
                        className="h-full ring-1 ring-outline-variant"
                >
                    <div class="p-6 md:p-8 h-full flex flex-col">
                        <h3 class="text-headline-small">Mes coordonnées</h3>

                        <div class="mt-8 flex flex-col gap-6">
                            <div class="flex items-center gap-4">
                                <span class="grid place-items-center size-12 shrink-0 rounded-2xl bg-primary-container text-on-primary-container">
                                    <Icon icon={iMail} className="size-6"/>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-title-medium">Email</p>
                                    <a
                                            class="mt-1 block break-words text-body-large text-on-surface-variant underline underline-offset-4 transition-colors hover:text-primary"
                                            href={mailtoHref}
                                    >
                                        {email}
                                    </a>
                                </div>
                            </div>

                            {phone && (
                                    <div class="flex items-center gap-4">
                                        <span class="grid place-items-center size-12 shrink-0 rounded-2xl bg-secondary-container text-on-secondary-container">
                                            <Icon icon={iCall} className="size-6"/>
                                        </span>
                                        <div class="min-w-0">
                                            <p class="text-title-medium">Téléphone</p>
                                            <a
                                                    class="mt-1 block text-body-large text-on-surface-variant underline underline-offset-4 transition-colors hover:text-primary"
                                                    href={`tel:${phoneHref}`}
                                            >
                                                {phoneLabel}
                                            </a>
                                        </div>
                                    </div>
                            )}

                            <div class="flex items-center gap-4">
                                <span class="grid place-items-center size-12 shrink-0 rounded-2xl bg-tertiary-container text-on-tertiary-container">
                                    <Icon icon={iLocationOn} className="size-6"/>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-title-medium">Mobilité</p>
                                    <p class="mt-1 text-body-large text-on-surface-variant">
                                        Déplacements autour d’Amiens et de Lille · à distance
                                    </p>
                                </div>
                            </div>
                        </div>

                        <h3 class="mt-10 text-title-large">Réseaux sociaux</h3>
                        <div class="mt-4 flex flex-wrap gap-4">
                            <a
                                    href={linkedin}
                                    target="_blank"
                                    rel="me noopener noreferrer"
                                    class="flex items-center gap-3 rounded-2xl bg-surface-container-high p-4 text-on-surface ring-1 ring-outline-variant transition-colors hover:bg-surface-container-highest hover:text-primary"
                            >
                                <Icon icon={faLinkedin} className="size-8"/>
                                <span class="text-title-medium hidden sm:block">LinkedIn</span>
                                <span class="sr-only"> (nouvel onglet)</span>
                            </a>
                            <a
                                    href={github}
                                    target="_blank"
                                    rel="me noopener noreferrer"
                                    class="flex items-center gap-3 rounded-2xl bg-surface-container-high p-4 text-on-surface ring-1 ring-outline-variant transition-colors hover:bg-surface-container-highest hover:text-primary"
                            >
                                <Icon icon={faGithub} className="size-8"/>
                                <span class="text-title-medium hidden sm:block">GitHub</span>
                                <span class="sr-only"> (nouvel onglet)</span>
                            </a>
                        </div>
                    </div>
                </Card>
            </div>

            <div class="lg:col-span-7 min-w-0">
                <Card
                        client:visible
                        variant="filled"
                        energyX
                        className="h-full ring-1 ring-primary/30"
                >
                    <div class="p-6 md:p-8 h-full flex flex-col">
                        <h3 class="text-headline-small">Votre message</h3>
                        <p class="mt-4 text-body-large text-on-surface-variant max-w-prose">
                            Indiquez-moi l’essentiel de votre demande. Le contexte, ce qui
                            existe déjà et ce que vous cherchez à obtenir suffisent pour
                            que je vous réponde utilement.
                        </p>

                        <FormContact client:visible/>
                    </div>
                </Card>
            </div>
        </div>

        <div class="pb-20 md:pb-28"></div>
    </div>
</section>
