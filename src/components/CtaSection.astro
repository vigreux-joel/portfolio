---
import { Button } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY;
---

<section class="tab-menu theme-blue bg-surface pb-20 md:pb-28">
  <div class="max-width padding-x">
    <div class="border-t border-outline-variant pt-12 md:pt-16 grid grid-cols-1 lg:grid-cols-[1.15fr_.85fr] gap-8 lg:gap-14 items-end">
      <div>
        <p class="text-title-large text-tertiary">Un besoin à faire avancer&nbsp;?</p>
        <h2 class="mt-4 text-headline-large md:text-display-small text-on-surface max-w-3xl">
          Présentez-moi le contexte, ce qui existe déjà et le point qui bloque aujourd’hui.
        </h2>
      </div>

      <div class="flex flex-col items-start lg:items-end gap-3">
        <Button client:visible href="/contact" label="Écrire à Joël" icon={iArrowForward} />
        {calendlyUrl && (
          <a href={calendlyUrl} target="_blank" rel="noopener noreferrer" class="text-label-large text-primary underline underline-offset-4">
            Réserver un créneau<span class="sr-only"> (nouvel onglet)</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
