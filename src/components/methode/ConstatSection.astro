---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { ConstatScroll } from "./ConstatScroll";

import { iSearch } from "@udixio/icons-outlined-400/search";
---

<div id="constat" class="theme-cyan bg-surface">
  <section class="max-width">
    <div class="flex pt-8">
      <div>
        <Line client:idle icon={iSearch} nextTheme="cyan" />
      </div>
      <div class="padding pt-0 flex flex-col justify-center max-w-4xl">
        <h2 class="sub-title" data-sidebar-label="Constat">Le constat</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
          <h3 class="text-gradient">La vitesse de l'IA a un prix caché</h3>
        </div>
        <p class="mt-6 text-body-large text-on-surface-variant max-w-prose">
          L'IA produit du code vite, et c'est utile. Le problème commence quand cette
          vitesse remplace le raisonnement : on obtient un résultat qui fonctionne en
          apparence, mais dont les choix techniques n'ont pas vraiment été assumés.
        </p>
      </div>
    </div>

    <div class="max-width relative z-20 mt-8 mb-16">
      <ConstatScroll client:idle />
    </div>

    <div class="flex h-24">
      <div>
        <Line client:idle />
      </div>
    </div>
  </section>

  <LinearGradient nextTheme="cyan" />
</div>
