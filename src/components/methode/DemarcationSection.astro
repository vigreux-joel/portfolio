---
import { Line } from "@components/Line";
import { LinearGradient } from "@components/LinearGradient";
import { Card } from "@components/Card";
import { Icon } from "@udixio/ui-react";

import { iCode } from "@udixio/icons-outlined-400/code";
import { iArchitecture } from "@udixio/icons-outlined-400/architecture";
---

<div id="demarcation" class="theme-orange surface">
  <section class="max-width">
    <!-- Introduction -->
    <div class="flex pt-8">
      <div>
        <Line client:idle icon={iArchitecture} nextTheme="purple" />
      </div>
      <div class="padding pt-0 flex flex-col justify-center max-w-4xl">
        <h2 class="text-title-large text-tertiary" data-sidebar-label="Démarcation">La démarcation</h2>
        <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
          <h3 class="text-gradient">Où s'arrête la machine, où commence l'ingénierie</h3>
        </div>
      </div>
    </div>

    <!-- Deux colonnes : contraste IA / humain -->
    <div class="padding-x mt-12 mb-12 grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">

      <!-- Colonne gauche : ce que je délègue à la machine -->
      <Card client:visible variant="filled" className="group">
        <div class="p-6 md:p-8 h-full flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="grid place-items-center h-12 w-12 rounded-2xl bg-surface-container-high text-on-surface-variant">
              <Icon icon={iCode} className="h-6 w-6" />
            </span>
            <span class="text-label-large text-on-surface-variant uppercase tracking-wide">Exécution</span>
          </div>
          <h4 class="text-headline-small md:text-headline-medium text-on-surface-variant mb-2">
            Ce que je délègue à la machine
          </h4>
          <p class="text-body-medium text-on-surface-variant mb-6">
            L'exécution, sans illusion sur ce qu'elle vaut.
          </p>
          <ul class="space-y-3 text-body-medium text-on-surface-variant">
            <li class="flex gap-3"><span class="text-on-surface-variant/60 mt-1">—</span>Génération de code répétitif et de tuyauterie technique</li>
            <li class="flex gap-3"><span class="text-on-surface-variant/60 mt-1">—</span>Premières versions de fonctions, tests, documentation</li>
            <li class="flex gap-3"><span class="text-on-surface-variant/60 mt-1">—</span>Accélération du time-to-market sur les tâches connues</li>
          </ul>
        </div>
      </Card>

      <!-- Colonne droite : ce que je suis seul à maîtriser -->
      <Card client:visible variant="filled" energyX className="group relative ring-1 ring-primary/30">
        <div class="p-6 md:p-8 h-full flex flex-col">
          <div class="flex items-center gap-3 mb-6">
            <span class="grid place-items-center h-12 w-12 rounded-2xl bg-primary text-on-primary">
              <Icon icon={iArchitecture} className="h-6 w-6" />
            </span>
            <span class="text-label-large text-tertiary uppercase tracking-wide">Maîtrise</span>
          </div>
          <h4 class="text-headline-small md:text-headline-medium mb-2">
            Ce que je suis seul à <span class="text-gradient">maîtriser</span>
          </h4>
          <p class="text-body-medium text-on-surface-variant mb-6">
            Les décisions qui déterminent si votre projet tiendra.
          </p>
          <ul class="space-y-3 text-body-medium text-on-surface">
            <li class="flex gap-3"><span class="text-primary mt-1 font-bold">+</span>Architecture pensée pour l'évolution de votre produit</li>
            <li class="flex gap-3"><span class="text-primary mt-1 font-bold">+</span>Protection des données et du business</li>
            <li class="flex gap-3"><span class="text-primary mt-1 font-bold">+</span>Traduction des enjeux métier en choix techniques</li>
            <li class="flex gap-3"><span class="text-primary mt-1 font-bold">+</span>Revue systématique : chaque ligne est lue, comprise, validée</li>
          </ul>
        </div>
      </Card>

    </div>

    <!-- Phrase de pivot -->
    <div class="padding-x pb-16">
      <p class="text-body-large max-w-prose mx-auto text-center text-on-surface">
        Déléguer l'exécution ne réduit pas l'exigence — elle l'élève. Plus l'IA
        s'invite dans un projet, plus le pilotage humain devient le facteur qui sépare
        un produit fiable d'une bombe à retardement.
      </p>
    </div>

    <div class="flex h-24">
      <div>
        <Line client:idle />
      </div>
    </div>
  </section>

  <LinearGradient nextTheme="purple" />
</div>
