---
import { Card } from "@components/Card";
import { Line } from '@components/Line';
import { LinearGradient } from "@components/LinearGradient";
import { Icon } from "@udixio/ui-react";

import { iRoute } from "@udixio/icons-outlined-400/route";
import { iSearch } from "@udixio/icons-outlined-400/search";
import { iRocketLaunch } from "@udixio/icons-outlined-400/rocket_launch";
import { iShield } from "@udixio/icons-outlined-400/shield";
import { iTaskAlt } from "@udixio/icons-outlined-400/task_alt";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { iCheckCircle } from "@udixio/icons-outlined-400/check_circle";
import { iVerifiedUser } from "@udixio/icons-outlined-400/verified_user";
---

<div id="process" class="theme-green bg-surface">
  <section>
    <div class="max-width">
      <div class="flex pt-8">
        <div>
          <Line client:idle icon={iRoute} nextTheme="green" />
        </div>
        <div class="padding pt-0 flex flex-col justify-center max-w-4xl">
          <h2 class="text-title-large text-tertiary" data-sidebar-label="Process">Les preuves</h2>
          <div class="mt-4 text-headline-large md:text-display-medium max-w-prose">
            <h3 class="text-gradient">Trois phases, un seul objectif : un produit qui tient</h3>
          </div>
          <p class="mt-6 text-body-large text-on-surface-variant max-w-prose">
            Pas de tunnel opaque ni de promesse abstraite. Le projet avance par étapes
            lisibles : cadrer correctement, produire vite quand c'est utile, puis contrôler
            sans compromis ce qui sera livré.
          </p>
        </div>
      </div>

      <div class="padding-x mt-12 mb-16 grid grid-cols-1 md:grid-cols-3 gap-6 md:auto-rows-min">
        <Card client:visible variant="filled" className="group md:col-span-1 md:row-span-1">
          <div class="p-6 md:p-8 h-full flex flex-col">
            <div class="flex items-center gap-3 mb-5">
              <span class="grid place-items-center h-12 w-12 rounded-2xl bg-secondary-container text-on-secondary-container">
                <Icon icon={iSearch} className="h-6 w-6" />
              </span>
              <div>
                <span class="block text-label-large text-on-surface-variant uppercase tracking-wide">Phase 01</span>
                <span class="block text-title-small text-on-surface">Cadrage & Vision</span>
              </div>
            </div>
            <span class="box-decoration-clone bg-primary/15 px-2 py-1 font-medium text-primary text-body-small w-fit mb-5">100% humain</span>

            <div class="space-y-2.5 mb-6">
              <p class="text-body-small text-on-surface-variant mb-3">Vous repartez avec :</p>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iCheckCircle} className="h-5 w-5 text-primary shrink-0" />
                <span>Une vision nette du périmètre</span>
              </div>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iCheckCircle} className="h-5 w-5 text-primary shrink-0" />
                <span>Une estimation transparente</span>
              </div>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iCheckCircle} className="h-5 w-5 text-primary shrink-0" />
                <span>Un découpage en lots validé</span>
              </div>
            </div>

            <div class="mt-auto pt-4 border-t border-outline-variant/40">
              <span class="inline-flex items-center gap-1.5 text-body-small text-on-surface-variant">
                <Icon icon={iTaskAlt} className="h-4 w-4 text-tertiary shrink-0" />
                Neutralise : <span class="text-on-surface font-medium">partir dans la mauvaise direction</span>
              </span>
            </div>
          </div>
        </Card>

        <Card client:visible variant="filled" energyX className="group md:col-span-2 md:row-span-2 relative ring-1 ring-primary/20">
          <div class="p-6 md:p-10 h-full flex flex-col">
            <div class="flex items-center gap-3 mb-5">
              <span class="grid place-items-center h-12 w-12 rounded-2xl bg-primary text-on-primary">
                <Icon icon={iRocketLaunch} className="h-6 w-6" />
              </span>
              <div>
                <span class="block text-label-large text-tertiary uppercase tracking-wide">Phase 02</span>
                <span class="block text-title-medium text-on-surface">Exécution propulsée</span>
              </div>
            </div>
            <span class="box-decoration-clone bg-tertiary/15 px-2 py-1 font-medium text-on-surface text-body-small w-fit mb-6">IA comme levier</span>

            <p class="text-body-large text-on-surface-variant max-w-prose mb-8">
              L'IA intervient pour accélérer ce qui peut l'être : maquettes, tuyauterie
              technique, tâches répétitives, premières versions de tests ou de documentation.
              Le gain de temps est réel, mais il ne remplace pas la responsabilité technique.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
              <div class="rounded-2xl bg-surface-container-low p-5">
                <div class="flex items-center gap-2 mb-2">
                  <Icon icon={iRocketLaunch} className="h-5 w-5 text-on-surface-variant" />
                  <span class="text-label-large text-on-surface-variant uppercase tracking-wide">Production</span>
                </div>
                <p class="text-body-medium text-on-surface-variant">
                  La machine propose vite une base de travail exploitable.
                </p>
              </div>
              <div class="rounded-2xl bg-tertiary/15 ring-1 ring-tertiary/30 p-5">
                <div class="flex items-center gap-2 mb-2">
                  <Icon icon={iFactCheck} className="h-5 w-5 text-tertiary" />
                  <span class="text-label-large text-tertiary uppercase tracking-wide">Validation</span>
                </div>
                <p class="text-body-medium text-on-surface">
                  Chaque morceau est relu, compris, corrigé si nécessaire, puis seulement intégré.
                </p>
              </div>
            </div>

            <div class="mt-auto pt-4 border-t border-outline-variant/40">
              <span class="inline-flex items-center gap-1.5 text-body-small text-on-surface-variant">
                <Icon icon={iTaskAlt} className="h-4 w-4 text-tertiary shrink-0" />
                Neutralise : <span class="text-on-surface font-medium">la lenteur, sans céder sur la fiabilité</span>
              </span>
            </div>
          </div>
        </Card>

        <Card client:visible variant="filled" className="group md:col-span-1 md:row-span-1">
          <div class="p-6 md:p-8 h-full flex flex-col">
            <div class="flex items-center gap-3 mb-5">
              <span class="grid place-items-center h-12 w-12 rounded-2xl bg-secondary-container text-on-secondary-container">
                <Icon icon={iShield} className="h-6 w-6" />
              </span>
              <div>
                <span class="block text-label-large text-on-surface-variant uppercase tracking-wide">Phase 03</span>
                <span class="block text-title-small text-on-surface">Rigueur & Contrôle</span>
              </div>
            </div>
            <span class="box-decoration-clone bg-primary/15 px-2 py-1 font-medium text-primary text-body-small w-fit mb-5">Expertise humaine</span>

            <div class="space-y-2.5 mb-6">
              <p class="text-body-small text-on-surface-variant mb-3">Contrôles systématiques :</p>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iFactCheck} className="h-5 w-5 text-primary shrink-0" />
                <span>Revue de code</span>
              </div>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iTaskAlt} className="h-5 w-5 text-primary shrink-0" />
                <span>Tests automatisés</span>
              </div>
              <div class="flex items-center gap-2 text-body-medium text-on-surface">
                <Icon icon={iVerifiedUser} className="h-5 w-5 text-primary shrink-0" />
                <span>Sécurisation</span>
              </div>
            </div>

            <div class="mt-auto pt-4 border-t border-outline-variant/40">
              <span class="inline-flex items-center gap-1.5 text-body-small text-on-surface-variant">
                <Icon icon={iTaskAlt} className="h-4 w-4 text-tertiary shrink-0" />
                Neutralise : <span class="text-on-surface font-medium">le code qui tombe en marche</span>
              </span>
            </div>
          </div>
        </Card>
      </div>

      <div class="flex h-24">
        <div>
          <Line client:idle />
        </div>
      </div>
    </div>
  </section>

  <LinearGradient nextTheme="blue" />
</div>
