---
import type { CollectionEntry } from "astro:content";
import ProjectTechnologies from "./ProjectTechnologies.astro";

interface Props {
  project: CollectionEntry<"projects">;
  class?: string;
  loading?: "eager" | "lazy";
}

const { project, class: className = "", loading = "lazy" } = Astro.props;
const { cover, technologies } = project.data;
---

{
  cover ? (
    <img
      src={cover.src}
      alt={cover.alt}
      width={cover.width}
      height={cover.height}
      loading={loading}
      decoding="async"
      class:list={["h-full w-full object-cover", className]}
    />
  ) : (
    <div
      class:list={[
        "relative flex h-full w-full flex-col justify-end overflow-hidden p-7 md:p-9",
        className,
      ]}
      aria-hidden="true"
    >
      <span class="absolute -right-16 -top-20 size-64 rounded-full bg-primary-container opacity-40 blur-2xl" />
      <span class="absolute -bottom-24 -left-12 size-56 rounded-full bg-tertiary-container opacity-30 blur-2xl" />

      <ProjectTechnologies technologies={technologies} class="relative" />
    </div>
  )
}
