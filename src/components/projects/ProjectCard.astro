---
import type { CollectionEntry } from "astro:content";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { Card } from "@components/Card";

import ProjectTechnologies from "./ProjectTechnologies.astro";
import ProjectVisual from "./ProjectVisual.astro";
import { IconButton } from "@udixio/ui-react";

interface Props {
  project: CollectionEntry<"projects">;
  linkLabel?: string;
}

const { project, linkLabel } = Astro.props;
const { data } = project;

const isRealisation = data.kind === "realisation";
const href = isRealisation ? data.externalUrl! : `/projets/${project.id}`;
const label = linkLabel ?? (isRealisation ? "Voir le site" : "Voir le projet");
const linkIcon = isRealisation ? iArrowOutward : iArrowForward;
---

<article>
  <Card client:visible interactive variant="filled" className="flex h-full flex-col">
    <a
      href={href}
      target={isRealisation ? "_blank" : undefined}
      rel={isRealisation ? "noopener noreferrer" : undefined}
      aria-label={`${label} : ${data.title}`}
      class="group/card-link relative z-10 flex h-full flex-col"
    >
      {
        data.cover && (
          <div class="relative aspect-16/10 overflow-hidden bg-surface-container">
            <ProjectVisual project={project} class="transition-transform duration-500 group-hover:scale-105" />
          </div>
        )
      }

      <IconButton
        icon={linkIcon}
        variant="outlined"
        className="absolute top-4 right-4 z-10"
      >
        {`${label} : ${data.title}`}
      </IconButton>

      <div class="flex flex-1 flex-col p-7">
        <div class:list={[!data.cover && "pr-16"]}>
          <p class="text-title-medium-large text-secondary">{data.eyebrow}</p>
          <h3 class="mt-2 text-headline-small text-on-surface">{data.title}</h3>
        </div>
        <p class="mt-4 text-body-medium text-on-surface-variant">{data.description}</p>

        {
          !data.cover && (
            <ProjectTechnologies
              technologies={data.technologies}
              label={`Technologies utilisées pour ${data.title}`}
              class="mt-auto pt-8"
            />
          )
        }
      </div>
    </a>
  </Card>
</article>
