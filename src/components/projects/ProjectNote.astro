---
import { Icon } from "@udixio/ui-react";
import { iLightbulb } from "@udixio/icons-outlined-400/lightbulb";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<aside class="my-8 rounded-3xl bg-tertiary-container p-6 md:p-8">
  <div class="flex items-center gap-3 text-primary">
    <Icon icon={iLightbulb} className="size-6 shrink-0" />
    <p class="text-title-large text-on-surface">{title}</p>
  </div>
  <div class="project-note__body mt-4 pl-9 text-body-large text-on-surface-variant">
    <slot />
  </div>
</aside>

<style>
  .project-note__body :global(p + p) {
    margin-top: 1rem;
  }

  .project-note__body :global(strong) {
    color: var(--color-on-surface);
  }
</style>
