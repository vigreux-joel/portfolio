---
import type { CollectionEntry } from "astro:content";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { iCheckCircle } from "@udixio/icons-outlined-400/check_circle";
import { Card } from "@components/Card";
import ProjectTechnologies from "./ProjectTechnologies.astro";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** Place le visuel à droite du texte plutôt qu’à gauche. */
  reverse?: boolean;
  caseStudyLabel?: string;
  externalLabel?: string;
  layout?: "horizontal" | "vertical";
}

const {
  project,
  reverse = false,
  caseStudyLabel = "Voir l’étude de cas",
  externalLabel,
  layout = "horizontal",
} = Astro.props;

const { data } = project;
const hasVisual = Boolean(data.cover || data.previewUrl);
const isHorizontal = layout === "horizontal";
const visualWidth = data.cover?.width ?? 1440;
const visualHeight = data.cover?.height ?? 900;
const paragraphs = isHorizontal && data.intro.length > 0 ? data.intro : [data.description];

const secondaryLink = data.externalUrl
  ? { href: data.externalUrl, label: externalLabel ?? `Ouvrir ${data.title}` }
  : data.repositoryUrl
    ? { href: data.repositoryUrl, label: externalLabel ?? "Voir le code sur GitHub" }
    : null;
---

<article>
  <Card client:visible variant="filled" className="overflow-hidden">
    <div class:list={[hasVisual && isHorizontal && "grid lg:grid-cols-[1.15fr_.85fr]"]}>
      {
        hasVisual && (
          <div
            class:list={[
              "overflow-hidden bg-surface-container",
              isHorizontal && "aspect-8/5 lg:aspect-auto lg:h-full lg:min-h-72",
              !isHorizontal && "self-start",
              reverse && isHorizontal && "lg:order-2",
            ]}
            style={!isHorizontal ? `aspect-ratio: ${visualWidth} / ${visualHeight}` : undefined}
          >
            <ProjectVisual project={project} fit={isHorizontal ? "cover" : "contain"} />
          </div>
        )
      }

      <div class:list={["p-7 md:p-10", !hasVisual && "max-w-5xl"]}>
        <p class="text-label-large text-secondary">{data.eyebrow}</p>
        <h3 class="mt-3 text-headline-large text-on-surface">{data.title}</h3>
        {data.headline && <p class="mt-4 text-headline-small text-on-surface">{data.headline}</p>}

        {
          paragraphs.map((paragraph) => (
            <p class="mt-6 text-body-large text-on-surface-variant">{paragraph}</p>
          ))
        }

        {
          isHorizontal && data.highlights.length > 0 && (
            <ul class="mt-8 grid gap-3 sm:grid-cols-2" aria-label={`Caractéristiques de ${data.title}`}>
              {data.highlights.map((highlight) => (
                <li class="flex items-start gap-3 text-body-medium text-on-surface-variant">
                  <Icon icon={iCheckCircle} className="mt-0.5 size-5 shrink-0 text-primary" />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          data.technologies.length > 0 && (
            <ProjectTechnologies
              technologies={data.technologies}
              label={`Technologies utilisées pour ${data.title}`}
              class="mt-8"
            />
          )
        }

        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <Button href={`/projets/${project.id}`} icon={iArrowForward} label={caseStudyLabel} />
          {
            secondaryLink && (
              <Button
                href={secondaryLink.href}
                icon={iArrowOutward}
                label={secondaryLink.label}
                variant="outlined"
              />
            )
          }
        </div>
      </div>
    </div>
  </Card>
</article>
