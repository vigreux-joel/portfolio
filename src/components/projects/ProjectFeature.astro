---
import type { CollectionEntry } from "astro:content";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { iCheckCircle } from "@udixio/icons-outlined-400/check_circle";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** Place le visuel à droite du texte plutôt qu’à gauche. */
  reverse?: boolean;
  caseStudyLabel?: string;
  externalLabel?: string;
}

const {
  project,
  reverse = false,
  caseStudyLabel = "Voir l’étude de cas",
  externalLabel,
} = Astro.props;

const { data } = project;
const paragraphs = data.intro.length > 0 ? data.intro : [data.description];

const secondaryLink = data.externalUrl
  ? { href: data.externalUrl, label: externalLabel ?? `Ouvrir ${data.title}` }
  : data.repositoryUrl
    ? { href: data.repositoryUrl, label: externalLabel ?? "Voir le code sur GitHub" }
    : null;
---

<article class="overflow-hidden rounded-3xl border border-outline-variant bg-surface-container-low">
  <div class="grid lg:grid-cols-[1.08fr_.92fr]">
    <div class:list={["min-h-72 bg-surface-container", reverse && "lg:order-2"]}>
      <ProjectVisual project={project} />
    </div>

    <div class="p-7 md:p-10 lg:p-12">
      <p class="text-label-large text-tertiary">{data.eyebrow}</p>
      <h3 class="mt-3 text-headline-large text-on-surface">{data.title}</h3>
      <p class="mt-4 text-headline-small text-on-surface">{data.headline}</p>

      {
        paragraphs.map((paragraph) => (
          <p class="mt-6 text-body-large text-on-surface-variant">{paragraph}</p>
        ))
      }

      {
        data.highlights.length > 0 && (
          <ul class="mt-8 grid gap-3 sm:grid-cols-2" aria-label={`Caractéristiques de ${data.title}`}>
            {data.highlights.map((highlight) => (
              <li class="flex items-start gap-3 text-body-medium text-on-surface-variant">
                <Icon icon={iCheckCircle} className="mt-0.5 size-5 shrink-0 text-primary" />
                <span>{highlight}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <Button href={`/projets/${project.id}`} icon={iArrowForward} label={caseStudyLabel} />
        {
          secondaryLink && (
            <Button
              href={secondaryLink.href}
              icon={iArrowOutward}
              label={secondaryLink.label}
              variant="outlined"
            />
          )
        }
      </div>
    </div>
  </div>
</article>
