---
import type { CollectionEntry } from "astro:content";
import { Button, Icon } from "@udixio/ui-react";
import { iArrowForward } from "@udixio/icons-outlined-400/arrow_forward";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { iCheckCircle } from "@udixio/icons-outlined-400/check_circle";
import { Card } from "@components/Card";
import ProjectTechnologies from "./ProjectTechnologies.astro";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** Place le visuel à droite du texte plutôt qu’à gauche. */
  reverse?: boolean;
  caseStudyLabel?: string;
  externalLabel?: string;
  layout?: "horizontal" | "vertical";
}

const {
  project,
  reverse = false,
  caseStudyLabel = "Voir l’étude de cas",
  externalLabel,
  layout = "horizontal",
} = Astro.props;

const { data } = project;
const hasVisual = Boolean(data.cover || data.previewUrl);
const isHorizontal = layout === "horizontal";
const visualWidth = data.cover?.width ?? 1440;
const visualHeight = data.cover?.height ?? 900;
const introduction = isHorizontal ? (data.intro ?? data.description) : data.description;
const isRealisation = data.kind === "realisation";
const visibleHighlights = isHorizontal ? data.highlights : data.highlights.slice(0, 3);

const primaryLink = isRealisation
  ? { href: data.externalUrl!, label: externalLabel ?? "Voir le site", icon: iArrowOutward }
  : { href: `/projets/${project.id}`, label: caseStudyLabel, icon: iArrowForward };

const secondaryLink = !isRealisation && data.externalUrl
  ? { href: data.externalUrl, label: externalLabel ?? `Ouvrir ${data.title}` }
  : data.repositoryUrl
    ? { href: data.repositoryUrl, label: externalLabel ?? "Voir le code sur GitHub" }
    : null;
---

<article class="h-full">
  <Card client:visible variant="filled" className="h-full overflow-hidden">
    <div class:list={[hasVisual && isHorizontal && "grid lg:grid-cols-[1.15fr_.85fr]"]}>
      {
        hasVisual && (
          <div
            class:list={[
              "overflow-hidden bg-surface-container",
              isHorizontal && "aspect-8/5 lg:aspect-auto lg:h-full lg:min-h-72",
              !isHorizontal && "self-start",
              reverse && isHorizontal && "lg:order-2",
            ]}
            style={!isHorizontal ? `aspect-ratio: ${visualWidth} / ${visualHeight}` : undefined}
          >
            <ProjectVisual project={project} fit={isHorizontal ? "cover" : "contain"} />
          </div>
        )
      }

      <div class:list={["p-7 md:p-10", !hasVisual && "max-w-5xl"]}>
        <p class="text-label-large text-secondary">{data.eyebrow}</p>
        <h3 class="mt-3 text-headline-large text-on-surface">{data.title}</h3>
        {data.headline && <p class="mt-4 text-headline-small text-on-surface">{data.headline}</p>}

        <p class="mt-6 text-body-large text-on-surface-variant">{introduction}</p>

        {
          isHorizontal && data.supportingText && (
            <p class="mt-6 border-l-2 border-primary/40 pl-4 text-body-medium text-on-surface-variant">
              {data.supportingText}
            </p>
          )
        }

        {
          !isHorizontal && !isRealisation && (
            <dl class="mt-7 grid gap-3 sm:grid-cols-2">
              <div class="rounded-2xl bg-surface-container-high/70 p-5">
                <dt class="text-label-large text-tertiary">Besoin</dt>
                <dd class="mt-2 line-clamp-3 text-body-medium text-on-surface-variant">
                  {data.need}
                </dd>
              </div>
              <div class="rounded-2xl bg-primary-container/35 p-5">
                <dt class="text-label-large text-primary">Réponse</dt>
                <dd class="mt-2 line-clamp-3 text-body-medium text-on-surface-variant">
                  {data.solution}
                </dd>
              </div>
            </dl>
          )
        }

        {
          visibleHighlights.length > 0 && (
            <ul class="mt-8 grid gap-3 sm:grid-cols-2" aria-label={`Points clés de ${data.title}`}>
              {visibleHighlights.map((highlight) => (
                <li class="flex items-start gap-3 text-body-medium text-on-surface-variant">
                  <Icon icon={iCheckCircle} className="mt-0.5 size-5 shrink-0 text-primary" />
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          data.technologies.length > 0 && (
            <ProjectTechnologies
              technologies={data.technologies}
              label={`Technologies utilisées pour ${data.title}`}
              class="mt-8"
            />
          )
        }

        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <Button href={primaryLink.href} icon={primaryLink.icon} label={primaryLink.label} />
          {
            secondaryLink && (
              <Button
                href={secondaryLink.href}
                icon={iArrowOutward}
                label={secondaryLink.label}
                variant="outlined"
              />
            )
          }
        </div>
      </div>
    </div>
  </Card>
</article>
