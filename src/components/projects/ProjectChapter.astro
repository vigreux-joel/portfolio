---
interface Props {
  eyebrow: string;
  title: string;
  number?: string;
}

const { eyebrow, title, number } = Astro.props;
---

<section class="project-chapter border-t border-outline-variant py-10 md:py-14">
  <div class="grid gap-5 lg:grid-cols-[minmax(9rem,14rem)_minmax(0,1fr)] lg:gap-12">
    <div class="flex items-start justify-between gap-4 lg:block">
      <p class="text-label-large text-tertiary">{eyebrow}</p>
      {number && <p class="text-label-large text-outline lg:mt-3">{number}</p>}
    </div>

    <div class="min-w-0 max-w-3xl">
      <h2 class="text-headline-medium text-on-surface md:text-headline-large">{title}</h2>
      <div class="project-chapter__body mt-6 text-body-large text-on-surface-variant">
        <slot />
      </div>
    </div>
  </div>
</section>

<style>
  .project-chapter__body :global(p) {
    margin-top: 1.25rem;
  }

  .project-chapter__body :global(p:first-child) {
    margin-top: 0;
  }

  .project-chapter__body :global(strong) {
    color: var(--color-on-surface);
  }

  .project-chapter__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
