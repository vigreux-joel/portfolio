---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/methode/HeroSection.astro";
import ConstatSection from "../components/methode/ConstatSection.astro";
import DemarcationSection from "../components/methode/DemarcationSection.astro";
import LegitimiteSection from "../components/methode/LegitimiteSection.astro";
import CtaSection from "@/components/CtaSection.astro";

const faq = [
    {
        question: "À quel moment l’IA intervient-elle ?",
        answer: "Une fois le besoin et ses contraintes clarifiés. Je la réserve aux tâches suffisamment cadrées : produire une première base, accélérer un travail répétitif ou préparer des tests et de la documentation. Ses propositions sont ensuite relues et corrigées avant d’être intégrées."
    },
    {
        question: "Comment se déroule un projet assisté par l’IA ?",
        answer: "Je commence par clarifier les objectifs, les usages et les contraintes, puis nous validons le périmètre et les étapes. L’IA peut accélérer une partie de la réalisation lorsque le cadre est clair. Chaque résultat est ensuite contrôlé avant de vous être présenté ou livré."
    },
    {
        question: "L’IA prend-elle des décisions sur le projet ?",
        answer: "Non. Elle peut proposer une réponse à une demande précise, mais elle ne connaît ni votre métier ni ce qui n’a pas été formulé. Je reste responsable des choix de conception, des arbitrages et des précautions à prendre ; vous validez la direction fonctionnelle du projet."
    },
    {
        question: "Comment la qualité du résultat est-elle vérifiée ?",
        answer: "Je ne m’arrête pas au parcours idéal qui fonctionne à l’écran. Je vérifie aussi les erreurs possibles, les cas limites, la protection des données et les conséquences sur le reste du projet. Le niveau de contrôle est adapté aux risques réels de chaque fonctionnalité."
    },
    {
        question: "Qui reste responsable du résultat livré ?",
        answer: "Moi. Je ne livre que ce que je comprends, peux expliquer et suis capable de corriger ou de faire évoluer. L’IA reste un outil d’exécution : elle ne remplace ni mon jugement ni ma responsabilité."
    },
    {
        question: "Le projet dépendra-t-il de l’IA après la livraison ?",
        answer: "Non. Vous récupérez un projet compréhensible et documenté, utilisable sans mes instructions ni les outils d’IA employés pendant sa réalisation. Je peux assurer le suivi, mais le projet doit aussi pouvoir être repris par un autre professionnel."
    }
];
---
<Layout
  showSidebar={false}
  showCta={false}
  faq={faq}
  seo={{
    title: `Joël Vigreux - Approche - L'IA génère du code, l'ingénierie construit des solutions`,
    description: "Mon approche : l'IA accélère l'écriture du code, l'ingénierie construit des solutions pérennes. Architecture, sécurité et revue de code systématique, du cadrage à la mise en production.",
    openGraph: {
      basic: {
        title: "Joël Vigreux - Approche de l’IA et de l’ingénierie",
        type: "website",
        image: "https://vigreux-joel.fr/images/photo.webp",
        url: "https://vigreux-joel.fr/approche",
      },
      optional: {
        siteName: "Joël Vigreux",
        locale: "fr_FR",
        description: "L'IA génère du code, l'ingénierie construit des solutions. Découvrez mon approche de l’IA, du cadrage à la mise en production.",
      },
      image: {
        alt: "Portrait de Joël Vigreux, développeur full-stack",
      },
    },
    twitter: {
      card: "summary_large_image",
      title: "Joël Vigreux - Approche de l’IA et de l’ingénierie",
      description: "L'IA génère du code, l'ingénierie construit des solutions.",
      image: "https://vigreux-joel.fr/images/photo.webp",
      imageAlt: "Portrait de Joël Vigreux",
    },
  }}
>
  <style is:global>
    @keyframes float {
      0% { transform: translateY(0) translateX(0) rotate(0deg); }
      50% { transform: translateY(-6px) translateX(2px) rotate(2deg); }
      100% { transform: translateY(0) translateX(0) rotate(0deg); }
    }
    .animate-float-slow { animation: float 6s ease-in-out infinite; }
    .animate-float-medium { animation: float 5s ease-in-out infinite; }
    .animate-float-fast { animation: float 4s ease-in-out infinite; }
    @keyframes chip-shake {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(-2px, 1px); }
      50% { transform: translate(2px, -1px); }
      75% { transform: translate(-1px, -2px); }
    }
    .chip-shake { animation: chip-shake 0.12s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) {
      .animate-float-slow, .animate-float-medium, .animate-float-fast, .chip-shake { animation: none; }
    }
  </style>

  <script type="application/ld+json" is:inline>
    {
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Joël Vigreux",
        "jobTitle": "Développeur full-stack",
        "url": "https://vigreux-joel.fr/approche",
        "image": "https://vigreux-joel.fr/images/photo.webp"
      })
    }
  </script>

  <HeroSection />
  <ConstatSection />
  <DemarcationSection />
  <LegitimiteSection />
  <CtaSection />
</Layout>
