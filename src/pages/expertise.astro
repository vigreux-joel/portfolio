---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/expertise/HeroSection.astro";
import FrontEndSection from "../components/expertise/FrontEndSection.astro";
import MultiplatformSection from "../components/expertise/MultiplatformSection.astro";
import UxSection from "../components/expertise/UxSection.astro";
import BackEndSection from "../components/expertise/BackEndSection.astro";

const faq = [
    {
        question: "Quelles technos maîtrisez-vous ?",
        answer: "Astro, React, Angular, Svelte côté front-end ; NestJS, Node.js, Prisma, PostgreSQL côté back-end ; Flutter pour le multiplateforme. Je m'adapte aussi à des stacks existantes."
    },
    {
        question: "Travaillez-vous sur du code existant ?",
        answer: "Oui. Je reprends des projets en cours, refactore le legacy et intègre de nouvelles fonctionnalités sans casser l'existant, avec une attention particulière à la dette technique."
    },
    {
        question: "Choisissez-vous la stack ou s'impose-t-elle ?",
        answer: "Je recommande la stack la plus pertinente selon votre produit, vos contraintes et votre public — pas la plus tendance. Mais si vous êtes déjà équipé, je m'appuie sur l'existant."
    },
    {
        question: "Proposez-vous de l'hébergement ?",
        answer: "Je vous oriente vers l'hébergement le plus adapté : plateforme managée (Vercel), hébergeur français (OVH) ou VPS Docker que je gère de bout en bout."
    }
];
---
<Layout
    faq={faq}
    seo={{
    title: `Joël Vigreux - Développeur full stack - Spécialiste Astro, React & NestJS`,
    description: "Expert en technologies modernes telles que Astro, NestJS et React ! Joël VIGREUX : Développeur full stack vous accompagne du back-end au frontend",
    openGraph: {
        basic: {
            title: "Joël Vigreux - Développeur full stack",
            type: "website",
            image: "https://vigreux-joel.fr/images/photo.webp",
            url: "https://vigreux-joel.fr/"
        },
        optional: {
            siteName: "Joël Vigreux",
            locale: "fr_FR",
            description: "Expert en technologies modernes telles que Astro, NestJS et React !"
        },
        image: {
            alt: "Portrait de Joël Vigreux, développeur full-stack"
        }
    },
    twitter: {
        card: "summary_large_image",
        title: "Joël Vigreux - Développeur full stack",
        description: "Spécialiste Astro, React & NestJS. Du back-end au front-end.",
        image: "https://vigreux-joel.fr/images/photo.webp",
        imageAlt: "Portrait de Joël Vigreux"
    }
}}>
    <style is:global>

        @keyframes float {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-6px) translateX(2px) rotate(2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        @keyframes float2 {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-10px) translateX(-2px) rotate(-2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        .animate-float-slow {
            animation: float 6s ease-in-out infinite;
        }

        .animate-float-medium {
            animation: float2 5s ease-in-out infinite;
        }

        .animate-float-fast {
            animation: float 4s ease-in-out infinite;
        }

        @media (prefers-reduced-motion: reduce) {
            .animate-float-slow, .animate-float-medium, .animate-float-fast {
                animation: none;
            }
        }
    </style>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Joël Vigreux",
                "jobTitle": "Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "image": "https://vigreux-joel.fr/images/photo.webp"
            })
        }
    </script>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Joël Vigreux - Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": "https://vigreux-joel.fr/?q={search_term_string}",
                    "query-input": "required name=search_term_string"
                }
            })
        }
    </script>
    

        <HeroSection />
        <FrontEndSection />
        <MultiplatformSection />
        <UxSection />
        <BackEndSection />


</Layout>