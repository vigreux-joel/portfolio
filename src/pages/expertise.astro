---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/expertise/HeroSection.astro";
import FrontEndSection from "../components/expertise/FrontEndSection.astro";
import MultiplatformSection from "../components/expertise/MultiplatformSection.astro";
import UxSection from "../components/expertise/UxSection.astro";
import BackEndSection from "../components/expertise/BackEndSection.astro";
import ApproachCta from "../components/expertise/ApproachCta.astro";

const faq = [
    {
        question: "Faut-il déjà savoir quelle solution choisir ?",
        answer: "Non. Vous pouvez me présenter votre objectif et les personnes qui utiliseront le projet. Je détermine avec vous s’il faut un site, une application ou une intervention plus ciblée ; les choix techniques suivent ensuite vos usages et vos contraintes."
    },
    {
        question: "Une intervention ciblée est-elle possible ?",
        answer: "Oui. Je peux intervenir sur une partie précise aux côtés de votre équipe, ou prendre en charge l’ensemble, de l’interface aux services qui la font fonctionner. Les responsabilités sont définies clairement dès le départ."
    },
    {
        question: "Faut-il conserver la base actuelle du projet ?",
        answer: "J’évalue sa qualité, ses contraintes et le coût réel de chaque option. Je conserve une base saine ; si elle freine durablement le projet, je propose de repartir sur des fondations plus adaptées en expliquant les bénéfices et les conséquences de ce choix."
    },
    {
        question: "Le contenu pourra-t-il être modifié sans aide ?",
        answer: "Oui, si le projet le demande. Je peux prévoir un espace d’administration adapté aux contenus à gérer, sans imposer un outil complexe pour un besoin simple."
    }
];
---
<Layout
    faq={faq}
    seo={{
    title: `Joël Vigreux - Développeur full stack - Spécialiste Astro, React & NestJS`,
    description: "Expert en technologies modernes telles que Astro, NestJS et React ! Joël VIGREUX : Développeur full stack vous accompagne du back-end au frontend",
    openGraph: {
        basic: {
            title: "Joël Vigreux - Développeur full stack",
            type: "website",
            image: "https://vigreux-joel.fr/images/photo.webp",
            url: "https://vigreux-joel.fr/"
        },
        optional: {
            siteName: "Joël Vigreux",
            locale: "fr_FR",
            description: "Expert en technologies modernes telles que Astro, NestJS et React !"
        },
        image: {
            alt: "Portrait de Joël Vigreux, développeur full-stack"
        }
    },
    twitter: {
        card: "summary_large_image",
        title: "Joël Vigreux - Développeur full stack",
        description: "Spécialiste Astro, React & NestJS. Du back-end au front-end.",
        image: "https://vigreux-joel.fr/images/photo.webp",
        imageAlt: "Portrait de Joël Vigreux"
    }
}}>
    <style is:global>

        @keyframes float {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-6px) translateX(2px) rotate(2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        @keyframes float2 {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-10px) translateX(-2px) rotate(-2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        .animate-float-slow {
            animation: float 6s ease-in-out infinite;
        }

        .animate-float-medium {
            animation: float2 5s ease-in-out infinite;
        }

        .animate-float-fast {
            animation: float 4s ease-in-out infinite;
        }

        @media (prefers-reduced-motion: reduce) {
            .animate-float-slow, .animate-float-medium, .animate-float-fast {
                animation: none;
            }
        }
    </style>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Joël Vigreux",
                "jobTitle": "Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "image": "https://vigreux-joel.fr/images/photo.webp"
            })
        }
    </script>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Joël Vigreux - Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": "https://vigreux-joel.fr/?q={search_term_string}",
                    "query-input": "required name=search_term_string"
                }
            })
        }
    </script>
    

        <HeroSection />
        <FrontEndSection />
        <MultiplatformSection />
        <UxSection />
        <BackEndSection />
        <ApproachCta />


</Layout>
