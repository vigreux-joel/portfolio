                <div class="absolute -top-4 -left-6 w-8 h-8 md:w-10 md:h-10 animate-float-slow opacity-80">
                    <div class="size-full rounded-full fill-secondary bg-on-surface-container/50 backdrop-blur-md ring-1 ring-outline flex items-center justify-center p-1">
                        <div class="size-full" set:html={reactLogo}></div>
