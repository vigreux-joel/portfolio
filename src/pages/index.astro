                                    <Divider className="hidden md:block border-primary-container"/>
                                </div>
                                <div class="flex gap-4 mt-4">
                                    <Divider orientation="vertical" className="md:hidden border-primary-container"/>
                                    <div class="flex flex-1 flex-wrap gap-8">
                                        <div
                                             class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                                            <Icon className="h-16 w-16" icon={faApple}/>
                                            <p>IOS</p>
                                        </div>
                                        <div
                                             class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-primary-container text-on-primary-container">
                                            <Icon className="h-16 w-16" icon={faAndroid}/>
                                            <p>Android</p>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="flex-[3] w-full md:w-fit">
                                <div class="flex gap-4 items-center">
                                    <Divider className="hidden md:block border-secondary-container"/>
                                    <h4 class="text-title-medium text-on-secondary-container">Desktop</h4>
                                    <Divider className="hidden md:block border-secondary-container"/>
                                </div>
                                <div class="flex gap-4 mt-4">
                                    <Divider orientation="vertical" className="md:hidden border-secondary-container"/>
                                    <div class="flex flex-1 flex-wrap gap-8">
                                        <div
                                             class="flex-[100%] lg:flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                                            <Icon className="h-16 w-16" icon={faWindows}/>
                                            <p>Windows</p>
                                        </div>
                                        <div
                                             class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                                            <Icon className="h-16 w-16" icon={faApple}/>
                                            <p>MacOs</p>
                                        </div>
                                        <div
                                             class="flex-1  py-4 px-8 rounded-lg flex flex-col items-center gap-4 bg-secondary-container text-on-secondary-container">
                                            <Icon className="h-16 w-16" icon={faLinux}/>
                                            <p>Linux</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <LinearGradient nextTheme="blue"/>
