import sassLogo from "@assets/images/sass-logo.svg?raw"
import layoutResponsive from "@assets/images/Responsive-pana.svg"
import flutterLogo from "@assets/images/flutter-logo.svg?raw"
import tailwindLogo from "@assets/images/tailwind-logo.svg?raw"
import baseLogo from "@assets/images/base-logo.svg?raw"
import portrait from "@assets/images/photo.png"
import {Contact} from "@components/Contact";
import {BackgroundColor} from "@components/BackgroundColor";
import {Icon} from "@udixio/ui-react"
import {Card} from "@components/Card"

import {Techno} from "@components/Techno"


import {Line} from '@components/Line'
import {LinearGradient} from "@components/LinearGradient";
import WowBackdrop from "@components/WowBackdrop";
import {iIdCard} from "@udixio/icons-outlined-400/id_card";
import {iMail} from "@udixio/icons-outlined-400/mail";
import {iInfo} from "@udixio/icons-outlined-400/info";
import {iDevices} from "@udixio/icons-outlined-400/devices";
import {iSelectWindow} from "@udixio/icons-outlined-400/select_window";
import {
    faAndroid,
    faApple,
    faGolang,
    faJava,
    faLinux, faNodeJs,
    faPhp,
    faPython,
    faSymfony,
    faWindows
