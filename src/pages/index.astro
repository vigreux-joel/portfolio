    <section id="ux" class="tab-menu theme-purple pt-8 !z-20">
        <div class="max-width">
            <div class="flex">
                <div>
                    <Line isLast client:idle icon={iDevices}/>
                </div>
                <div class="padding pt-0">
                    <h2 class="text-title-large">Design & Ux</h2>
                    <div
                         class="mt-4 text-headline-large md:text-display-medium max-w-prose">
