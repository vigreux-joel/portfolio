                            <h3 class="text-gradient">Performance et flexibilité garantie</h3>
                            <p>J'assure vos projets avec des technologies modernes et adaptables</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex flex-col justify-end ">
                <BackgroundColor speed={7_500} size="max(50vw, 800px)" count={5} client:idle
                                 className="absolute opacity-30 size-full top-0 left-0"></BackgroundColor>

            </div>


        </div>

        <LinearGradient nextTheme="purple"/>
    </section>
    <div id="front-end" class=" tab-menu theme-purple">
        <section>
            <div class="max-width ">

                <div class="padding-x grid grid-cols-1 -mx-2 md:grid-cols-3 lg:grid-cols-3 gap-x-6 gap-y-4">
                    <Card client:visible
