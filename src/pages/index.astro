                            </div>
                        </div>

                    </div>
                </div>
                <div class="flex mt-8 ">
                    <div class="theme-purple not-detect-theme">
                        <Line client:idle icon={iCode} isLast/>
                    </div>
                    <div class="padding pt-0 max-w-screen-lg">
                        <h2 class="text-title-large text-tertiary transition-all duration-1000">
                            Développement
