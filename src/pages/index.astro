import {iApi} from "@udixio/icons-outlined-400/api";
import {iManufacturing} from "@udixio/icons-outlined-400/manufacturing";
import {iCode} from "@udixio/icons-outlined-400/code";

---
<Layout seo={{
    title: `Joël Vigreux - Développeur full stack - Spécialiste Astro, React & NestJS`,
    description: "Expert en technologies modernes telles que Astro, NestJS et React ! Joël VIGREUX : Développeur full stack vous accompagne du back-end au frontend",
    openGraph: {
        basic: {
            title: "Joël Vigreux - Développeur full stack",
            type: "website",
            image: "https://vigreux-joel.fr/images/photo.webp",
            url: "https://vigreux-joel.fr/"
        },
        optional: {
            siteName: "Joël Vigreux",
            locale: "fr_FR",
            description: "Expert en technologies modernes telles que Astro, NestJS et React !"
        },
        image: {
            alt: "Portrait de Joël Vigreux, développeur full-stack"
        }
    },
    twitter: {
        card: "summary_large_image",
        title: "Joël Vigreux - Développeur full stack",
        description: "Spécialiste Astro, React & NestJS. Du back-end au front-end.",
        image: "https://vigreux-joel.fr/images/photo.webp",
        imageAlt: "Portrait de Joël Vigreux"
    }
}}>
    <style is:global>

        @keyframes float {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-6px) translateX(2px) rotate(2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        @keyframes float2 {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
            50% {
                transform: translateY(-10px) translateX(-2px) rotate(-2deg);
            }
            100% {
                transform: translateY(0) translateX(0) rotate(0deg);
            }
        }

        .animate-float-slow {
            animation: float 6s ease-in-out infinite;
        }

        .animate-float-medium {
            animation: float2 5s ease-in-out infinite;
        }

        .animate-float-fast {
            animation: float 4s ease-in-out infinite;
        }

        @media (prefers-reduced-motion: reduce) {
            .animate-float-slow, .animate-float-medium, .animate-float-fast {
                animation: none;
            }
        }
    </style>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Joël Vigreux",
                "jobTitle": "Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "image": "https://vigreux-joel.fr/images/photo.webp"
            })
        }
    </script>
    <script type="application/ld+json" is:inline>
        {
            JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebSite",
                "name": "Joël Vigreux - Développeur full-stack",
                "url": "https://vigreux-joel.fr/",
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": "https://vigreux-joel.fr/?q={search_term_string}",
                    "query-input": "required name=search_term_string"
                }
            })
        }
    </script>
    <section id="accueil" class="tab-menu  ">
        <div class="max-width relative z-10 flex flex-col md:flex-row-reverse min-[120rem]:flex-row justify-end min-[120rem]:justify-start min-[120rem]:px-0 items-start md:items-center mb-8 gap-12 md:gap-24 padding-x pt-32 md:pt-42 xl:pt-54">
            <div class="relative ml-8 md:ml-0">
                <!-- Halo gradient derrière la photo -->
                <div class="absolute inset-0 -z-10 blur-2xl rounded-full pointer-events-none"
