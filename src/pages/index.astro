---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeExperienceProof from "../components/home/HomeExperienceProof.astro";
import HomeContextPaths from "../components/home/HomeContextPaths.astro";
import HomeProjectsPreview from "../components/home/HomeProjectsPreview.astro";
import HomeExpertisePreview from "../components/home/HomeExpertisePreview.astro";
import HomeMethodPreview from "../components/home/HomeMethodPreview.astro";

const faq = [
  {
    question: "Sur quels types de produits pouvez-vous intervenir ?",
    answer:
      "Sur un site, une application web ou un outil métier, pour développer une première version, ajouter une fonctionnalité ou reprendre une base existante. Mon périmètre couvre le front-end et les services back-end qui lui sont nécessaires.",
  },
  {
    question: "Pouvez-vous reprendre un code existant ?",
    answer:
      "Oui. Je commence par comprendre l’architecture, les conventions et les contraintes de la base actuelle. L’objectif est d’avancer progressivement sans imposer une réécriture complète par principe.",
  },
  {
    question: "Comment se déroule un premier échange ?",
    answer:
      "Vous pouvez me présenter ce qui existe, l’objectif recherché et le point qui bloque aujourd’hui. Je vous réponds avec les premières questions utiles pour préciser le périmètre, les contraintes et la prochaine étape.",
  },
  {
    question: "Pouvez-vous intégrer une équipe déjà constituée ?",
    answer:
      "Oui. Je m’adapte aux outils, aux conventions et au rythme déjà en place. Je partage les décisions importantes et documente ce qui doit l’être pour que ma contribution reste compréhensible par l’équipe.",
  },
];

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://vigreux-joel.fr/#joel-vigreux",
  name: "Joël Vigreux",
  jobTitle: "Développeur full-stack",
  url: "https://vigreux-joel.fr/",
  image: "https://vigreux-joel.fr/images/photo.webp",
  description:
    "Développeur full-stack spécialisé dans l’écosystème TypeScript. Développement et évolution d’applications web, du front-end aux services back-end.",
  sameAs: [
    "https://github.com/vigreux-joel",
    "https://linkedin.com/in/vigreux-joel",
  ],
  knowsAbout: [
    "Développement web",
    "Astro",
    "React",
    "Angular",
    "TypeScript",
    "NestJS",
    "Accessibilité web",
    "Architecture logicielle",
  ],
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "Titre professionnel de niveau 5",
    name: "Développeur web et web mobile",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Béthune",
    addressCountry: "FR",
  },
});

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Joël Vigreux - Développeur full-stack",
  url: "https://vigreux-joel.fr/",
  inLanguage: "fr-FR",
  publisher: { "@id": "https://vigreux-joel.fr/#joel-vigreux" },
});

const profilePageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://vigreux-joel.fr/#profile-page",
  url: "https://vigreux-joel.fr/",
  name: "Joël Vigreux — Développeur full-stack",
  description:
    "Expérience, projet, expertise et méthode de Joël Vigreux, développeur full-stack spécialisé dans l’écosystème TypeScript.",
  inLanguage: "fr-FR",
  dateModified: "2026-07-22",
  mainEntity: { "@id": "https://vigreux-joel.fr/#joel-vigreux" },
});
---

<Layout
  showSidebar={false}
  faq={faq}
  seo={{
    title: "Joël Vigreux — Développeur full-stack TypeScript",
    description:
      "Développeur full-stack spécialisé en TypeScript. Je développe et fais évoluer des applications web, du front-end aux services back-end.",
    openGraph: {
      basic: {
        title: "Joël Vigreux — Développeur full-stack",
        type: "website",
        image: "https://vigreux-joel.fr/images/photo.webp",
        url: "https://vigreux-joel.fr/",
      },
      optional: {
        siteName: "Joël Vigreux",
        locale: "fr_FR",
        description:
          "Des interfaces soignées sur des fondations solides, du front-end aux services back-end.",
      },
      image: {
        alt: "Portrait de Joël Vigreux, développeur full-stack",
      },
    },
    twitter: {
      card: "summary_large_image",
      title: "Joël Vigreux - Développeur full-stack",
      description:
        "Développement et évolution d’applications web, du front-end aux services back-end.",
      image: "https://vigreux-joel.fr/images/photo.webp",
      imageAlt: "Portrait de Joël Vigreux",
    },
  }}
>
  <script type="application/ld+json" is:inline set:html={personJsonLd} />
  <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
  <script type="application/ld+json" is:inline set:html={profilePageJsonLd} />

  <HomeHero />
  <HomeExperienceProof />
  <HomeProjectsPreview />
  <HomeExpertisePreview />
  <HomeMethodPreview />
  <HomeContextPaths />
</Layout>
