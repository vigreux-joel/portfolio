                            </Techno>
                        </Card>
                    </div>
                    <div class="flex h-64">
                        <div>
                            <Line client:idle isFirst/>
                        </div>
                    </div>
                </div>
            </section>
            <section class="pt-8">
                <BackgroundColor speed={5_000} size="max(60vw, 800px)" count={5} client:idle
