---
import Layout from "../layouts/Layout.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeExpertisePreview from "../components/home/HomeExpertisePreview.astro";
import HomeContextPaths from "../components/home/HomeContextPaths.astro";
import HomeProjectsPreview from "../components/home/HomeProjectsPreview.astro";

const faq = [
  {
    question: "Peut-on confier un projet web complet à un seul développeur ?",
    answer:
      "Oui, lorsque son périmètre reste compatible avec une intervention individuelle. Mon profil full-stack me permet de cadrer les usages, concevoir l’interface, développer son fonctionnement et préparer sa mise en ligne. Si le projet exige plusieurs spécialistes en parallèle, ce besoin doit être identifié dès le départ.",
  },
  {
    question: "Comment démarrer un projet web lorsque le besoin n’est pas encore précis ?",
    answer:
      "Une idée, un objectif ou un problème à résoudre suffit pour commencer. Le premier échange sert à identifier les utilisateurs concernés, les actions importantes et les contraintes du projet avant de choisir une solution ou des technologies.",
  },
  {
    question: "À quel moment faire intervenir un développeur dans un projet web ?",
    answer:
      "L’idéal est de l’associer dès le cadrage pour vérifier la faisabilité et éviter que des choix fonctionnels créent ensuite des contraintes inutiles. Un développeur peut aussi rejoindre un projet plus tard pour réaliser une fonctionnalité, faire évoluer l’existant ou reprendre une base déjà en production.",
  },
];

const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://vigreux-joel.fr/#joel-vigreux",
  name: "Joël Vigreux",
  jobTitle: "Développeur full-stack",
  url: "https://vigreux-joel.fr/",
  image: "https://vigreux-joel.fr/images/photo.webp",
  description:
    "Développeur full-stack spécialisé dans l’écosystème TypeScript. Développement et évolution d’applications web, du front-end aux services back-end.",
  sameAs: [
    "https://github.com/vigreux-joel",
    "https://linkedin.com/in/vigreux-joel",
  ],
  knowsAbout: [
    "Développement web",
    "Astro",
    "React",
    "Angular",
    "TypeScript",
    "NestJS",
    "Accessibilité web",
    "Architecture logicielle",
  ],
  hasCredential: {
    "@type": "EducationalOccupationalCredential",
    credentialCategory: "Titre professionnel de niveau 5",
    name: "Développeur web et web mobile",
  },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Béthune",
    addressCountry: "FR",
  },
});

const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Joël Vigreux - Développeur full-stack",
  url: "https://vigreux-joel.fr/",
  inLanguage: "fr-FR",
  publisher: { "@id": "https://vigreux-joel.fr/#joel-vigreux" },
});

const profilePageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://vigreux-joel.fr/#profile-page",
  url: "https://vigreux-joel.fr/",
  name: "Joël Vigreux · Développeur full-stack",
  description:
    "Projets, approche technique et modes de collaboration de Joël Vigreux, développeur full-stack spécialisé dans l’écosystème TypeScript.",
  inLanguage: "fr-FR",
  dateModified: "2026-08-02",
  mainEntity: { "@id": "https://vigreux-joel.fr/#joel-vigreux" },
});
---

<Layout
  showSidebar={false}
  faq={faq}
  seo={{
    title: "Joël Vigreux · Développeur full-stack TypeScript",
    description:
      "Développeur full-stack spécialisé en TypeScript. Je développe et fais évoluer des applications web, du front-end aux services back-end.",
    openGraph: {
      basic: {
        title: "Joël Vigreux · Développeur full-stack",
        type: "website",
        image: "https://vigreux-joel.fr/images/photo.webp",
        url: "https://vigreux-joel.fr/",
      },
      optional: {
        siteName: "Joël Vigreux",
        locale: "fr_FR",
        description:
          "Des interfaces soignées sur des fondations solides, du front-end aux services back-end.",
      },
      image: {
        alt: "Portrait de Joël Vigreux, développeur full-stack",
      },
    },
    twitter: {
      card: "summary_large_image",
      title: "Joël Vigreux - Développeur full-stack",
      description:
        "Développement et évolution d’applications web, du front-end aux services back-end.",
      image: "https://vigreux-joel.fr/images/photo.webp",
      imageAlt: "Portrait de Joël Vigreux",
    },
  }}
>
  <script type="application/ld+json" is:inline set:html={personJsonLd} />
  <script type="application/ld+json" is:inline set:html={websiteJsonLd} />
  <script type="application/ld+json" is:inline set:html={profilePageJsonLd} />

  <HomeHero />
  <HomeExpertisePreview />
  <HomeProjectsPreview />
  <HomeContextPaths />
</Layout>
