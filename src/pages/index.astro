        </div>
        <div class="max-width flex justify-between  h-full">
            <div class="relative z-10 flex flex-col overflow-visible">
                <div class="theme-blue  flex flex-col  relative ">

                    <div class="flex">
                        <div>
                            <Line client:load visible isFirst/>
                        </div>
                        <div class="padding !pb-16">
                        </div>
                    </div>
                    <div class="flex flex-1 mt-8">
                        <div>
                            <Line client:load icon={iIdCard } nextTheme="purple"/>
                        </div>
                        <div class="padding pt-0">
                            <h2 class="text-headline-small  mb-4 text-tertiary ">À propos de moi</h2>
                            <p class="text-body-large max-w-3xl ">
                                Passionné de développement web, je conçois et développe des interfaces légères et
                                accessibles, alliant design et maintenabilité.
                            </p>
                            <!--<div class="-ml-6 mr-6 mt-8 flex gap-8 max-w-screen-md">-->
                            <!--    <Card variant="elevated"-->
                            <!--          className="p-4 px-6 bg-surface-container-high/50 w-fit flex-col flex">-->
                            <!--        <div class="flex-1">-->
                            <!--            <p class="text-title-medium">Front-end</p>-->
                            <!--            <p class="mt-2 text-on-surface-variant">-->
                            <!--                Expert en sites web et applications multiplateformes-->
                            <!--            </p>-->
                            <!--        </div>-->

                            <!--        <Button className="mt-2" variant="text" size="xSmall" disableTextMargins>En savoir plus-->
