                            <!--    </Card>-->
                            <!--    <Card variant="elevated"-->
                            <!--          className="p-4 px-6 bg-surface-container-high/50 w-fit flex-col flex">-->
                            <!--        <div class="flex-1">-->
                            <!--            <p class="text-title-medium">Design & UX</p>-->
                            <!--            <p class="mt-2 text-on-surface-variant">-->
                            <!--                Parcours et navigation optimisés pour une expérience fluide et agréable-->
                            <!--            </p>-->
                            <!--        </div>-->

                            <!--        <Button className="mt-2" variant="text" size="xSmall" disableTextMargins>En savoir plus-->
                            <!--        </Button>-->
                            <!--    </Card>-->
                            <!--    <Card variant="elevated"-->
                            <!--          className="p-4 px-6 bg-surface-container-high/50 w-fit flex-col flex">-->
                            <!--        <div class="flex-1">-->
                            <!--            <p class="text-title-medium">Back-end</p>-->
                            <!--            <p class="mt-2 text-on-surface-variant">-->
