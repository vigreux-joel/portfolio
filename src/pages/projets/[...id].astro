---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Line } from "@components/Line";
import { Button } from "@udixio/ui-react";
import { iArrowOutward } from "@udixio/icons-outlined-400/arrow_outward";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { BackgroundColor } from "@components/BackgroundColor";
import ProjectTechnologies from "@components/projects/ProjectTechnologies.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => !data.draft && data.kind === "etude-de-cas",
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
const projectUrl = new URL(`/projets/${project.id}`, Astro.site ?? Astro.url.origin).toString();

const faq = data.faq;
---

<Layout
  showSidebar={false}
  faq={faq}
  seo={{
    title: `${data.title} — Projet de Joël Vigreux`,
    description: data.description,
    openGraph: {
      basic: {
        title: `${data.title} — Projet de Joël Vigreux`,
        type: "article",
        image: new URL(data.cover?.src ?? "/images/photo.webp", Astro.site ?? Astro.url.origin).toString(),
        url: projectUrl,
      },
      optional: {
        siteName: "Joël Vigreux",
        locale: "fr_FR",
        description: data.description,
      },
      image: { alt: data.cover?.alt ?? `${data.title} — projet de Joël Vigreux` },
    },
  }}
>
  <section class="tab-menu theme-cyan pt-32 md:pt-42 xl:pt-54">
    <BackgroundColor
      speed={9_000}
      size="max(66vw, 800px)"
      count={4}
      client:idle
      className="absolute inset-x-0 top-0 -z-10 h-[52rem] opacity-20"
    />
    <div class="max-width">
      <div class="flex">
        <div><Line client:load isFirst /></div>
        <div class="padding pt-0 pb-12">
          <a
            href="/projets"
            class="mb-7 inline-flex items-center gap-2 text-label-large text-primary underline-offset-4 hover:underline"
          >
            <span class="sr-only">Retour à la page </span>
            <span aria-hidden="true">←</span>
            Projets
          </a>
          <p class="sub-title">{data.heroContext}</p>
          <h1 class="mt-5 text-display-medium xl:text-display-large max-w-5xl">
            <span class="block text-gradient">{data.headline}</span>
            <span class="block">{data.heroResponse}</span>
          </h1>
          <p class="mt-6 text-body-large text-on-surface-variant max-w-3xl">{data.description}</p>
          <ProjectTechnologies
            technologies={data.technologies}
            label={`Technologies utilisées pour ${data.title}`}
            class="mt-8"
          />
        </div>
      </div>

      {data.cover && (
        <figure class="padding-x mt-4">
          <div class="overflow-hidden rounded-3xl border border-outline-variant bg-surface-container-low p-2 md:p-3">
            <img
              src={data.cover.src}
              alt={data.cover.alt}
              width={data.cover.width}
              height={data.cover.height}
              class="w-full rounded-2xl object-cover"
            />
          </div>
          {data.cover.caption && <p class="mt-3 text-body-small text-on-surface-variant">{data.cover.caption}</p>}
        </figure>
      )}

      <div class="flex h-24 md:h-32"><div><Line client:idle icon={iFactCheck} /></div></div>

      <div class="padding-x">
        <div class="grid gap-4 lg:grid-cols-12">
          <div class="rounded-3xl bg-surface-container-low p-6 md:p-8 lg:col-span-7">
            <p class="text-label-large text-tertiary">Le besoin</p>
            <p class="mt-4 text-headline-small text-on-surface">{data.need}</p>
          </div>
          <div class="rounded-3xl bg-primary-container p-6 text-on-primary-container md:p-8 lg:col-span-5 lg:row-span-2">
            <p class="text-label-large">Ma réponse</p>
            <p class="mt-4 text-headline-small">{data.solution}</p>
          </div>
          <div class="rounded-3xl border border-outline-variant p-6 md:p-8 lg:col-span-7">
            <p class="text-label-large text-tertiary">Cadre technique</p>
            <p class="mt-3 text-body-large text-on-surface-variant">{data.technicalNote}</p>
          </div>
        </div>
      </div>

      <article
        class="padding-x mt-16 pb-20 md:mt-24"
      >
        <Content />

        {(data.externalUrl || data.repositoryUrl) && (
          <div class="mt-4 flex flex-wrap gap-4 border-t border-outline-variant pt-10">
            {data.externalUrl && (
              <Button href={data.externalUrl} icon={iArrowOutward} label="Ouvrir le projet" />
            )}
            {data.repositoryUrl && (
              <Button
                href={data.repositoryUrl}
                icon={iArrowOutward}
                label="Voir le code sur GitHub"
                variant={data.externalUrl ? "outlined" : "filled"}
              />
            )}
          </div>
        )}

        <a
          href="/projets"
          class="mt-12 inline-flex items-center gap-2 text-label-large text-primary underline-offset-4 hover:underline"
        >
          <span aria-hidden="true">←</span>
          Voir tous les projets
        </a>
      </article>
    </div>
  </section>
</Layout>
