---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Line } from "@components/Line";
import ProjectCard from "@components/projects/ProjectCard.astro";
import ProjectDetailedCard from "@components/projects/ProjectDetailedCard.astro";
import { sortProjects } from "../../utils/projects";
import { iFactCheck } from "@udixio/icons-outlined-400/fact_check";
import { BackgroundColor } from "@components/BackgroundColor";

const published = await getCollection("projects", ({ data }) => !data.draft);
const projects = sortProjects(published);

const collectionJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://vigreux-joel.fr/projets#collection",
  url: "https://vigreux-joel.fr/projets",
  name: "Projets — Joël Vigreux",
  description:
    "Études de cas et réalisations de Joël Vigreux, développeur full-stack spécialisé dans l’écosystème TypeScript.",
  inLanguage: "fr-FR",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.data.title,
      url:
        project.data.kind === "etude-de-cas"
          ? `https://vigreux-joel.fr/projets/${project.id}`
          : project.data.externalUrl,
    })),
  },
});
---

<Layout
  showSidebar={false}
  faq={[]}
  seo={{
    title: "Projets — Joël Vigreux, développeur full-stack",
    description:
      "Études de cas détaillées et réalisations livrées : bibliothèque de composants, applications métier, sites en production.",
    openGraph: {
      basic: {
        title: "Projets — Joël Vigreux",
        type: "website",
        image: "https://vigreux-joel.fr/images/photo.webp",
        url: "https://vigreux-joel.fr/projets",
      },
      optional: {
        siteName: "Joël Vigreux",
        locale: "fr_FR",
        description:
          "Études de cas détaillées et réalisations livrées par Joël Vigreux, développeur full-stack.",
      },
      image: {
        alt: "Portrait de Joël Vigreux, développeur full-stack",
      },
    },
  }}
>
  <script type="application/ld+json" is:inline set:html={collectionJsonLd} />

  <section class="tab-menu theme-cyan pt-32 md:pt-42 xl:pt-54">
    <BackgroundColor
      speed={9_000}
      size="max(66vw, 800px)"
      count={4}
      client:idle
      className="absolute inset-x-0 top-0 -z-10 h-[46rem] opacity-20"
    />
    <div class="max-width">
      <div class="flex">
        <div><Line client:load isFirst /></div>
        <div class="padding pt-0 pb-16">
          <p class="sub-title">Projets</p>
          <h1 class="mt-5 text-display-medium xl:text-display-large max-w-5xl">
            <span class="block text-gradient">Jugez mon travail à travers mes projets.</span>
            Je montre ce que j’ai conçu et pourquoi.
          </h1>
          <p class="mt-7 text-body-large text-on-surface-variant max-w-3xl">
            Chaque projet correspond à une réalisation concrète. Lorsque le contexte le permet,
            j’en détaille aussi le besoin, les choix effectués et mon rôle.
          </p>
        </div>
      </div>

      <div class="flex items-end">
        <div><Line client:idle icon={iFactCheck} /></div>
        <div class="padding pt-0 pb-8 w-full">
          <div class="flex flex-col justify-between gap-4 border-b border-outline-variant pb-6 sm:flex-row sm:items-end">
            <div>
              <p class="text-label-large text-tertiary">Sélection complète</p>
              <h2 class="mt-2 text-headline-large md:text-display-small">Projets réalisés</h2>
            </div>
            <p class="text-title-medium text-on-surface-variant">
              {String(projects.length).padStart(2, "0")} réalisations
            </p>
          </div>
        </div>
      </div>

      <ol class="padding-x grid items-stretch gap-6 md:grid-cols-2">
        {projects.map((project) => (
          <li class="min-w-0">
            {
              project.data.kind === "etude-de-cas" ? (
                <ProjectDetailedCard project={project} layout="vertical" />
              ) : (
                <ProjectCard project={project} />
              )
            }
          </li>
        ))}
      </ol>

      <div class="pb-20 md:pb-28"></div>
    </div>
  </section>
</Layout>
